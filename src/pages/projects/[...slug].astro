---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { hasCaseStudy } from "../../utils/projects";

/**
 * Case-study pages for projects that carry a real write-up.
 *
 * A section heading is the threshold: a project with only a one-line body gets
 * no page (a near-empty page is worse than none) and keeps linking out to its
 * demo instead.
 */
export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((project) => hasCaseStudy(project.body))
    .sort(
      (a, b) =>
        Number(!!b.data.featured) - Number(!!a.data.featured) ||
        (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
        a.data.title.localeCompare(b.data.title),
    );
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const facts = [
  data.year && { label: "Year", value: data.year },
  data.role && { label: "Role", value: data.role },
  data.clientWork && { label: "Type", value: "Client work" },
  data.mobile && { label: "Platform", value: "Android" },
  { label: "Status", value: data.demoUrl ? "Live" : data.githubUrl ? "Open source" : "Shipped" },
].filter(Boolean) as { label: string; value: string }[];
---

<Layout title={data.title} description={data.description}>
  <article class="case">
    <a href="/#work" class="case__back font-mono">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5m6 6-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      All work
    </a>

    <header class="case__header">
      <p class="section-label section-head__eyebrow" data-enter style="--d: 0">Case study</p>
      <h1 class="case__title" data-enter style="--d: 1">{data.title}</h1>
      <p class="case__lead text-pretty" data-enter style="--d: 2">{data.description}</p>

      <dl class="case__facts" data-enter style="--d: 3">
        {
          facts.map((f) => (
            <div>
              <dt class="section-label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        data.techStack && data.techStack.length > 0 && (
          <ul class="tag-list case__tags" aria-label="Tech stack">
            {data.techStack.map((tech) => (
              <li class="tag">{tech}</li>
            ))}
          </ul>
        )
      }

      <div class="case__actions">
        {
          data.demoUrl && (
            <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
              Visit live
              <svg class="icon-arrow-ur" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )
        }
        {
          data.githubUrl && (
            <a
              href={data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`btn${data.demoUrl ? "" : " btn--primary"}`}
            >
              View source
              <svg class="icon-arrow-ur" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )
        }
      </div>
    </header>

    {
      data.image && (
        <figure class="case__hero">
          <Image
            src={data.image}
            alt={`${data.title} screenshot`}
            widths={[640, 1024, 1400, 1800]}
            sizes="(min-width: 1024px) 960px, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="blog-content">
      <Content />
    </div>

    {
      next && next.slug !== project.slug && (
        <a class="case__next" href={`/projects/${next.slug}/`}>
          <span class="section-label">Next project</span>
          <span class="case__next-title">
            {next.data.title}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="case__next-desc line-clamp-2">{next.data.description}</span>
        </a>
      )
    }
  </article>
</Layout>

<style>
  .case {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }
  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-soft);
  }
  .case__back svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.35s var(--ease-spring);
  }
  .case__back:hover {
    color: var(--text);
  }
  .case__back:hover svg {
    transform: translateX(-3px);
  }

  .case__header {
    margin: 2.5rem 0 3rem;
  }
  .case__title {
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.055em;
    color: var(--text);
  }
  .case__lead {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .case__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.25rem 0;
    border-block: 1px solid var(--border);
  }
  .case__facts dd {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
  }
  .case__tags {
    margin-top: 1.5rem;
  }
  .case__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .case__hero {
    width: min(60rem, calc(100vw - 2.5rem));
    margin: 0 0 3.5rem calc(50% - min(30rem, 50vw - 1.25rem));
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--bg-elevated);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.5);
  }
  .case__hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .case__next {
    display: grid;
    gap: 0.6rem;
    margin-top: 5rem;
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--bg-elevated);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.25s var(--ease-soft);
  }
  .case__next:hover {
    border-color: var(--border-strong);
  }
  .case__next-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--text);
  }
  .case__next-title svg {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    padding: 0.4rem;
    border-radius: 999px;
    background: var(--accent-solid);
    color: var(--on-accent-solid);
    transition: transform 0.45s var(--ease-spring);
  }
  .case__next:hover .case__next-title svg {
    transform: translateX(4px);
  }
  .case__next-desc {
    max-width: 32rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
</style>
