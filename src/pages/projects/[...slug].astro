---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { hasCaseStudy } from "../../utils/projects";

/**
 * Case-study pages for projects that carry a real write-up.
 *
 * The bodies already existed in src/content/projects/*.md but nothing rendered
 * them, so every project link went straight off-site. A section heading is the
 * threshold: a project with only a one-line body gets no page (a near-empty
 * page is worse than none) and keeps linking out to its demo instead.
 */
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((project) => hasCaseStudy(project.body))
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const meta = [data.role, data.year].filter(Boolean).join(" · ");
---

<Layout title={data.title} description={data.description}>
  <article class="py-8 md:py-12">
    <div class="max-w-2xl">
      <a
        href="/#work"
        class="inline-flex items-center gap-2 text-sm font-medium mb-8 transition-colors hover:opacity-90"
        style="color: var(--accent-text);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All work
      </a>

      <header class="mb-10 pb-8 border-b border-[var(--border)]">
        {meta && <p class="section-label mb-3">{meta}</p>}
        <h1
          class="font-display text-3xl md:text-5xl font-bold mb-5 leading-tight"
          style="color: var(--text);"
        >
          {data.title}
        </h1>
        <p class="text-lg leading-relaxed mb-6" style="color: var(--text-muted);">
          {data.description}
        </p>

        {data.techStack && data.techStack.length > 0 && (
          <ul class="flex flex-wrap gap-2 mb-6" aria-label="Tech stack">
            {data.techStack.map((tech) => (
              <li
                class="rounded-md px-2 py-0.5 text-xs font-medium"
                style="background: var(--accent-muted); color: var(--accent-text);"
              >
                {tech}
              </li>
            ))}
          </ul>
        )}

        <div class="flex flex-wrap gap-4">
          {data.demoUrl && (
            <a
              href={data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-spring inline-flex items-center gap-2 rounded-xl border-2 px-5 py-2 text-sm font-semibold"
              style="border-color: var(--accent); color: var(--accent-text); background-color: transparent;"
            >
              Live site
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7m10 0v10" />
              </svg>
            </a>
          )}
          {data.githubUrl && (
            <a
              href={data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-spring inline-flex items-center gap-2 rounded-xl border-2 px-5 py-2 text-sm font-semibold"
              style="border-color: var(--border); color: var(--text); background-color: var(--bg-elevated);"
            >
              Source
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
          )}
        </div>
      </header>

      {data.image && (
        <div class="mb-12 rounded-2xl overflow-hidden border border-[var(--border)]">
          <Image
            src={data.image}
            alt={`${data.title} screenshot`}
            widths={[640, 1024, 1400]}
            sizes="(min-width: 768px) 672px, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="blog-content">
        <Content />
      </div>

      <footer class="mt-12 pt-8 border-t border-[var(--border)]">
        <a
          href="/#work"
          class="inline-flex items-center gap-2 text-sm font-semibold transition-colors hover:opacity-90"
          style="color: var(--accent-text);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All work
        </a>
      </footer>
    </div>
  </article>
</Layout>
