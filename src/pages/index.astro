<script>
  /**
   * Bento behaviour: the "Now" card plays its items like stories, and the
   * stats card counts up when it scrolls into view. Both leave the static
   * markup alone with reduced motion, so nothing is hidden without JS.
   */
  const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initStories() {
    document.querySelectorAll<HTMLElement>("[data-stories]:not(.is-live)").forEach((card) => {
      if (reduceMotion()) return;
      const items = Array.from(card.querySelectorAll<HTMLElement>(".stories__item"));
      const bars = Array.from(card.querySelectorAll<HTMLElement>(".stories__bar"));
      let current = 0;
      const show = (i: number) => {
        current = (i + items.length) % items.length;
        items.forEach((el, n) => el.classList.toggle("is-active", n === current));
        bars.forEach((bar, n) => {
          bar.classList.toggle("is-done", n < current);
          bar.classList.remove("is-active");
        });
        // Restart the fill animation on the active bar
        void bars[current].offsetWidth;
        bars[current].classList.add("is-active");
      };
      bars.forEach((bar) =>
        bar.querySelector("i")!.addEventListener("animationend", () => show(current + 1)),
      );
      items.forEach((el, n) => el.addEventListener("click", () => show(n)));
      card.classList.add("is-live");
      show(0);
    });
  }

  function initCounters() {
    document.querySelectorAll<HTMLElement>("[data-count-group]:not(.is-armed)").forEach((group) => {
      if (reduceMotion()) return;
      const numbers = Array.from(group.querySelectorAll<HTMLElement>("[data-count]"));
      group.classList.add("is-armed");
      numbers.forEach((el) => (el.textContent = "0"));
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          group.classList.add("is-counted");
          const start = performance.now();
          const duration = 1400;
          const step = (now: number) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(2, -10 * t);
            numbers.forEach((el) => {
              el.textContent = String(Math.round(Number(el.dataset.count) * (t === 1 ? 1 : eased)));
            });
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        },
        { threshold: 0.4 },
      );
      io.observe(group);
    });
  }

  function init() {
    initStories();
    initCounters();
  }
  document.addEventListener("astro:page-load", init);
  init();
</script>
