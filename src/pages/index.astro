---
import Layout from "../layouts/Layout.astro";
import TechStack from "../components/TechStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import {
  AVAILABLE_FOR_WORK,
  EMAIL,
  LOCATION,
  NAME,
  RESUME_URL,
  SITE_TITLE,
  TIMEZONE_LABEL,
} from "../consts";
import { hasCaseStudy } from "../utils/projects";
import { readingMinutes } from "../utils/reading";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestPost = posts[0];

const allProjects = await getCollection("projects");

const featured = allProjects
  .filter((p) => p.data.featured && !p.data.clientWork)
  .sort(
    (a, b) =>
      (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
      a.data.title.localeCompare(b.data.title),
  );

/** Everything not in the featured stack, newest first. */
const archive = allProjects
  .filter((p) => !featured.includes(p))
  .sort(
    (a, b) =>
      Number(b.data.year ?? 0) - Number(a.data.year ?? 0) ||
      a.data.title.localeCompare(b.data.title),
  )
  .map((p) => {
    const kind = p.data.clientWork ? "client" : p.data.mobile ? "app" : "personal";
    const caseStudy = hasCaseStudy(p.body) ? `/projects/${p.slug}/` : null;
    const href = caseStudy ?? p.data.demoUrl ?? p.data.githubUrl ?? null;
    return {
      project: p,
      kind,
      href,
      external: !caseStudy && !!href,
      label: { client: "Client", app: "App", personal: "Personal" }[kind],
    };
  });

const clientCount = allProjects.filter((p) => p.data.clientWork).length;
const appCount = allProjects.filter((p) => p.data.mobile).length;

const experiences = (await getCollection("experience")).sort(
  (a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime(),
);

function monthYear(date: string) {
  return new Date(date).toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
function shortDate(date: Date) {
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

const filters = [
  { id: "all", label: "All", count: archive.length },
  { id: "client", label: "Client", count: archive.filter((a) => a.kind === "client").length },
  { id: "personal", label: "Personal", count: archive.filter((a) => a.kind === "personal").length },
  { id: "app", label: "Apps", count: archive.filter((a) => a.kind === "app").length },
];

const now = [
  {
    tag: "Freelance",
    text: "Building web platforms, Android apps and backends for clients.",
  },
  {
    tag: "Training",
    text: "Teaching Nimzo, my from-scratch chess engine, to play past 1000 Elo.",
  },
  {
    tag: "Open source",
    text: "Shipping Wrangl: any REST API to an MCP server in one command.",
  },
];
---

<Layout title={SITE_TITLE} fullTitle={true} wideLayout={true}>
  <!-- ================================================================ Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__grid grid-bg" aria-hidden="true"></div>

    <div class="hero__chips" data-enter style="--d: 0">
      <span class="chip">
        <span class={`live-dot${AVAILABLE_FOR_WORK ? "" : " live-dot--off"}`}></span>
        {AVAILABLE_FOR_WORK ? "Available for new projects" : "Currently booked"}
      </span>
      <span class="chip font-mono">
        {LOCATION} · <time data-clock>{TIMEZONE_LABEL}</time>
      </span>
    </div>

    <h1 id="hero-title" class="hero__title" data-enter style="--d: 1">
      <span class="sr-only">{NAME}, </span>
      Software engineer
      <br />
      shipping <span class="serif-accent">real products</span>
      <br />
      &amp; <span class="serif-accent hero__accent">odd experiments.</span>
    </h1>

    <div class="hero__foot">
      <p class="hero__lead text-pretty" data-enter style="--d: 2">
        I'm <strong>Amir Aman</strong>, a software engineer in Ethiopia. I build production web apps
        with TypeScript and Next.js, Android apps with React Native, and backends in Node, Python and
        Go. Lately: MCP tooling for AI agents, a chess engine trained from scratch, and creatures that
        evolve to walk in your browser.
      </p>
      <div class="hero__actions" data-enter style="--d: 3">
        <button type="button" class="btn btn--primary" data-copy={EMAIL}>
          Copy email
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h8"></path>
          </svg>
        </button>
        <a class="btn" href="#work">
          See the work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14m-6-6 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        {
          RESUME_URL && (
            <a class="btn btn--ghost" href={RESUME_URL}>
              Download CV
            </a>
          )
        }
      </div>
    </div>
  </section>

  <div class="hero__marquee" data-enter style="--d: 4">
    <TechStack variant="marquee" />
  </div>

  <!-- =============================================================== Bento -->
  <section id="about" class="block section-reveal" aria-label="About">
    <div class="bento">
      <article class="bento__cell bento__about card spotlight">
        <div class="bento__about-head">
          <img src="/logo.png" alt="" width="56" height="56" class="bento__avatar" />
          <div>
            <p class="bento__name">{NAME}</p>
            <p class="section-label">Software Engineer</p>
          </div>
        </div>
        <h2 class="bento__about-title">
          I like hard problems that end up in <span class="serif-accent">someone's hands.</span>
        </h2>
        <div class="bento__about-body text-pretty">
          <p>
            I studied software engineering at Adama Science and Technology University, built
            payment-backed event platforms at Efuye-Gela, and now work independently, shipping
            for clients and for myself.
          </p>
          <p>
            I care about the boring parts that make things trustworthy: idempotency, honest
            numbers, offline-first apps, and pages that load fast on slow connections.
          </p>
        </div>
        <ul class="bento__prev" aria-label="Previously">
          <li class="section-label">Previously</li>
          {
            experiences
              .filter((e) => !e.data.current)
              .map((e) => <li>{e.data.company.split(",")[0]}</li>)
          }
        </ul>
      </article>

      <article class="bento__cell bento__now card spotlight">
        <p class="section-label bento__label">
          <span class="live-dot"></span> Now
        </p>
        <ul class="bento__now-list">
          {
            now.map((item) => (
              <li>
                <span class="tag">{item.tag}</span>
                <span>{item.text}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="bento__cell bento__clock card spotlight">
        <svg class="bento__globe" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="96"></circle>
          <ellipse cx="100" cy="100" rx="60" ry="96"></ellipse>
          <ellipse cx="100" cy="100" rx="24" ry="96"></ellipse>
          <path d="M4 100h192M16 52h168M16 148h168"></path>
          <circle class="bento__pin" cx="128" cy="92" r="5"></circle>
        </svg>
        <p class="section-label bento__label">Local time</p>
        <p class="bento__time font-mono"><time data-clock="short">--:--</time></p>
        <p class="bento__muted">{LOCATION} ({TIMEZONE_LABEL}). Happy to work across time zones.</p>
      </article>

      <article class="bento__cell bento__stats card spotlight">
        <p class="section-label bento__label">By the numbers</p>
        <dl class="bento__numbers">
          <div>
            <dt>Projects shipped</dt>
            <dd>{allProjects.length}</dd>
          </div>
          <div>
            <dt>Client builds</dt>
            <dd>{clientCount}</dd>
          </div>
          <div>
            <dt>Android apps</dt>
            <dd>{appCount}</dd>
          </div>
          <div>
            <dt>Essays</dt>
            <dd>{posts.length}</dd>
          </div>
        </dl>
      </article>

      <article class="bento__cell bento__stack card spotlight">
        <p class="section-label bento__label">Toolbox</p>
        <TechStack variant="grid" />
      </article>

      {
        latestPost && (
          <a href={`/blog/${latestPost.slug}`} class="bento__cell bento__post card spotlight">
            <p class="section-label bento__label">Latest essay</p>
            <p class="bento__post-title text-balance">{latestPost.data.title}</p>
            <p class="bento__post-meta font-mono">
              <span>{shortDate(latestPost.data.pubDate)}</span>
              <span>{readingMinutes(latestPost.body)} min read</span>
            </p>
            <span class="bento__post-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        )
      }
    </div>
  </section>

  <!-- ======================================================= Selected work -->
  <section id="work" class="block" aria-labelledby="work-title">
    <div class="section-head section-reveal">
      <div>
        <p class="section-label section-head__eyebrow">01 · Selected work</p>
        <h2 id="work-title" class="section-head__title">
          Things I've built <span class="serif-accent">and shipped.</span>
        </h2>
      </div>
      <p class="section-head__aside">
        From neural networks running in a browser tab to the queue that keeps a Telegram shop's
        inbox honest. Each one has a write-up on what was hard.
      </p>
    </div>

    <div class="work-stack">
      {featured.map((project, i) => <ProjectCard project={project} index={i} total={featured.length} />)}
    </div>
  </section>

  <!-- ============================================================ Archive -->
  <section id="archive" class="block section-reveal" aria-labelledby="archive-title">
    <div class="section-head">
      <div>
        <p class="section-label section-head__eyebrow">02 · Archive</p>
        <h2 id="archive-title" class="section-head__title">
          Everything <span class="serif-accent">else.</span>
        </h2>
      </div>
      <p class="section-head__aside">
        Client sites, side projects and Android apps. Smaller, but all real and all shipped.
      </p>
    </div>

    <!-- Pure-CSS filter: the radios drive :has() selectors below, no JS. -->
    <div class="archive">
      <fieldset class="archive__filters">
        <legend class="sr-only">Filter projects</legend>
        {
          filters.map((f, i) => (
            <label class="archive__filter">
              <input type="radio" name="archive-filter" value={f.id} checked={i === 0} class="sr-only" />
              {f.label}
              <span class="archive__count font-mono">{f.count}</span>
            </label>
          ))
        }
      </fieldset>

      <ul class="archive__list">
        {
          archive.map(({ project, kind, href, external, label }) => {
            const inner = (
              <>
                <span class="archive__year font-mono">{project.data.year ?? "—"}</span>
                <span class="archive__main">
                  <span class="archive__title">{project.data.title}</span>
                  <span class="archive__desc line-clamp-2">{project.data.description}</span>
                </span>
                <span class="archive__kind font-mono">{label}</span>
                <span class="archive__stack font-mono">
                  {(project.data.techStack ?? []).slice(0, 3).join(" · ")}
                </span>
                <span class="archive__go" aria-hidden="true">
                  {href && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      {external ? (
                        <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
                      ) : (
                        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                      )}
                    </svg>
                  )}
                </span>
              </>
            );
            return (
              <li class="archive__item" data-kind={kind}>
                {href ? (
                  <a
                    class="archive__row"
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                  >
                    {inner}
                  </a>
                ) : (
                  <div class="archive__row">{inner}</div>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- ========================================================= Experience -->
  <section id="experience" class="block section-reveal" aria-labelledby="exp-title">
    <div class="section-head">
      <div>
        <p class="section-label section-head__eyebrow">03 · Experience</p>
        <h2 id="exp-title" class="section-head__title">
          Where I've <span class="serif-accent">worked.</span>
        </h2>
      </div>
      <a class="btn" href="/experience">
        Full timeline
        <svg class="icon-arrow-r" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ol class="xp">
      {
        experiences.map((e) => (
          <li class="xp__row">
            <span class="xp__date font-mono">
              {monthYear(e.data.startDate)} — {e.data.endDate ? monthYear(e.data.endDate) : "Now"}
            </span>
            <span class="xp__role">
              {e.data.position}
              {e.data.current && <span class="live-dot" aria-label="Current role" />}
            </span>
            <span class="xp__company">{e.data.company}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============================================================ Writing -->
  <section id="writing" class="block section-reveal" aria-labelledby="writing-title">
    <div class="section-head">
      <div>
        <p class="section-label section-head__eyebrow">04 · Writing</p>
        <h2 id="writing-title" class="section-head__title">
          Notes &amp; <span class="serif-accent">opinions.</span>
        </h2>
      </div>
      <a class="btn" href="/blog">
        All writing
        <svg class="icon-arrow-r" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ul class="posts">
      {
        posts.slice(0, 4).map((post) => (
          <li>
            <a class="posts__row" href={`/blog/${post.slug}`}>
              <time class="posts__date font-mono" datetime={post.data.pubDate.toISOString()}>
                {shortDate(post.data.pubDate)}
              </time>
              <span class="posts__title text-balance">{post.data.title}</span>
              <span class="posts__read font-mono">{readingMinutes(post.body)} min</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .block {
    margin-top: clamp(6rem, 12vw, 9.5rem);
  }

  /* ------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    padding: clamp(3.5rem, 10vw, 7rem) 0 clamp(3rem, 6vw, 4.5rem);
  }
  .hero__glow {
    position: absolute;
    top: -12rem;
    left: 50%;
    z-index: -1;
    width: min(64rem, 100vw);
    height: 34rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent) 20%, transparent),
      transparent
    );
    filter: blur(30px);
    pointer-events: none;
  }
  .hero__grid {
    position: absolute;
    inset: -6rem calc(50% - 50vw) 0;
    z-index: -2;
    opacity: 0.55;
    mask-image: radial-gradient(60% 70% at 50% 30%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(60% 70% at 50% 30%, #000, transparent 75%);
    pointer-events: none;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2rem;
    padding: 0 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
    backdrop-filter: blur(8px);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .chip.font-mono {
    font-size: 0.72rem;
  }

  .hero__title {
    margin-top: 1.75rem;
    font-size: clamp(2.6rem, 8.6vw, 6.75rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: var(--text);
  }
  .hero__title .serif-accent {
    letter-spacing: -0.025em;
  }
  .hero__accent {
    color: var(--accent-text);
  }

  .hero__foot {
    display: grid;
    gap: 2rem;
    margin-top: 2.25rem;
  }
  @media (min-width: 900px) {
    .hero__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 4rem;
    }
  }
  .hero__lead {
    max-width: 36rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    color: var(--text-muted);
  }
  .hero__lead strong {
    color: var(--text);
    font-weight: 600;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero__marquee {
    padding: 1.4rem 0;
    border-block: 1px solid var(--border);
  }

  /* ------------------------------------------------------------ Bento */
  .bento {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 680px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento__about,
    .bento__now,
    .bento__stack,
    .bento__post {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .bento__about {
      grid-row: span 2;
    }
  }

  .bento__cell {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .bento__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }

  /* About */
  .bento__about {
    padding: 1.75rem;
  }
  .bento__about-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .bento__avatar {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
    box-shadow: 0 0 0 1px var(--border-strong);
  }
  .bento__name {
    margin-bottom: 0.2rem;
    font-weight: 600;
    color: var(--text);
  }
  .bento__about-title {
    margin-top: 2rem;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .bento__about-title .serif-accent {
    color: var(--accent-text);
  }
  .bento__about-body {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .bento__prev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: auto;
    padding-top: 1.75rem;
    font-size: 0.85rem;
    color: var(--text);
  }
  .bento__prev li:not(:first-child)::before {
    content: "↳ ";
    color: var(--text-faint);
  }

  /* Now */
  .bento__now-list {
    display: grid;
    gap: 0.85rem;
  }
  .bento__now-list li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text);
  }
  .bento__now-list .tag {
    justify-self: start;
  }
  @media (max-width: 420px) {
    .bento__now-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
  }

  /* Clock */
  .bento__clock {
    position: relative;
    min-height: 13rem;
  }
  .bento__globe {
    position: absolute;
    right: -3.5rem;
    bottom: -3.5rem;
    width: 11rem;
    height: 11rem;
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bento__globe ellipse {
      animation: spin-y 9s linear infinite;
      transform-origin: center;
      transform-box: fill-box;
    }
    .bento__globe ellipse + ellipse {
      animation-delay: -4.5s;
    }
  }
  @keyframes spin-y {
    from { transform: scaleX(1); }
    50% { transform: scaleX(-1); }
    to { transform: scaleX(1); }
  }
  .bento__pin {
    fill: var(--accent);
    stroke: none;
  }
  .bento__time {
    font-size: clamp(2.25rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .bento__muted {
    position: relative;
    max-width: 13rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Stats */
  .bento__numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 0.75rem;
    margin-top: auto;
  }
  .bento__numbers div {
    display: flex;
    flex-direction: column-reverse;
  }
  .bento__numbers dd {
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .bento__numbers dt {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Latest post */
  .bento__post {
    position: relative;
    min-height: 13rem;
    transition: border-color 0.25s var(--ease-soft);
  }
  .bento__post:hover {
    border-color: var(--border-strong);
  }
