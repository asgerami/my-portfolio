---
import Layout from "../layouts/Layout.astro";
import TechStack from "../components/TechStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { EMAIL, RESUME_URL, SITE_TITLE, SOCIALS } from "../consts";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )
  .slice(0, 2);

const allProjects = await getCollection("projects");

const featuredProjects = allProjects
  .filter((p) => !p.data.clientWork)
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    const orderA = a.data.order ?? Infinity;
    const orderB = b.data.order ?? Infinity;
    if (orderA !== orderB) return orderA - orderB;
    return a.data.title.localeCompare(b.data.title);
  });

const clientProjects = allProjects
  .filter((p) => p.data.clientWork)
  .sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0));

/** Bare hostname for client-work cards, e.g. "hiwetagri.org". */
function hostname(url?: string) {
  if (!url) return "";
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}

/** Two-letter monogram so cards read as distinct marks ("HEINEKEN E-Boiler" -> "HE"). */
function monogram(title: string) {
  const words = title.split(/[\s-]+/).filter(Boolean);
  if (words.length === 0) return "";
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return (words[0][0] + words[1][0]).toUpperCase();
}

const railItems = [
  { num: "01", label: "About", id: "about" },
  { num: "02", label: "Stack", id: "stack" },
  { num: "03", label: "Work", id: "work" },
  { num: "04", label: "Client Work", id: "client-work" },
  { num: "05", label: "Writing", id: "writing" },
  { num: "06", label: "Contact", id: "contact" },
];
---

<Layout title={SITE_TITLE} fullTitle={true} wideLayout={true} railItems={railItems}>
  <div class="py-8 md:py-12">
    <!-- Hero / About -->
    <section id="about" class="mb-16 md:mb-20 animate-fade-in">
      <p class="section-label mb-4 2xl:hidden">01</p>
      <h1
        class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight mb-5"
        style="color: var(--text);"
      >
        Amir Aman
      </h1>
      <div class="hero-rule mb-6" aria-hidden="true"></div>
      <p
        class="text-xl md:text-2xl font-display font-medium mb-4 max-w-2xl"
        style="color: var(--accent-text);"
      >
        Software Engineer specializing in scalable web architectures.
      </p>
      <div
        class="max-w-2xl space-y-4 text-base md:text-lg leading-relaxed mb-8 flex flex-col"
        style="color: var(--text-muted);"
      >
        <p>
          I architect and build robust applications using Node.js, Next.js, and React. My focus is on crafting scalable backend systems, designing intuitive user experiences, and writing clean, maintainable code.
        </p>
        <p>
          Beyond web development, I have a strong interest in high-performance computing and Machine Learning. I'm currently expanding my expertise in C++ and exploring ML concepts, sharing my technical insights and discoveries on my blog.
        </p>
      </div>
      <!-- The primary action keeps people on the site and opens a conversation.
           Both CTAs used to be outbound links to other platforms. -->
      <div class="flex flex-wrap gap-4">
        <a
          href={`mailto:${EMAIL}`}
          class="btn-spring inline-flex items-center gap-2 rounded-xl border-2 px-6 py-2.5 text-sm font-semibold"
          style="border-color: var(--accent-solid); background-color: var(--accent-solid); color: var(--on-accent-solid);"
        >
          Get in touch
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </a>
        {
          RESUME_URL && (
            <a
              href={RESUME_URL}
              class="btn-spring inline-flex items-center gap-2 rounded-xl border-2 px-6 py-2.5 text-sm font-semibold"
              style="border-color: var(--accent); color: var(--accent-text); background-color: transparent;"
            >
              Download CV
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"
                />
              </svg>
            </a>
          )
        }
        <a
          href={SOCIALS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-spring inline-flex items-center gap-2 rounded-xl border-2 px-6 py-2.5 text-sm font-semibold"
          style="border-color: var(--border); color: var(--text); background-color: var(--bg-elevated);"
        >
          GitHub
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
        </a>
        <a
          href={SOCIALS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-spring inline-flex items-center gap-2 rounded-xl border-2 px-6 py-2.5 text-sm font-semibold"
          style="border-color: var(--border); color: var(--text); background-color: var(--bg-elevated);"
        >
          LinkedIn
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
        </a>
      </div>
    </section>

    <!-- Tech Stack -->
    <section
      id="stack"
      class="section-reveal mb-16 md:mb-24"
      aria-labelledby="tech-heading"
    >
      <div class="section-head">
        <span class="section-label 2xl:hidden">02</span>
        <h2
          id="tech-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Stack
        </h2>
      </div>
      <div class="stagger-item">
        <TechStack />
      </div>
    </section>

    <!-- Work -->
    <section
      id="work"
      class="section-reveal mb-16 md:mb-24"
      aria-labelledby="work-heading"
    >
      <div class="section-head">
        <span class="section-label 2xl:hidden">03</span>
        <h2
          id="work-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Work
        </h2>
      </div>
      {
        featuredProjects.length > 0 ? (
          <div class="flex flex-col">
            {featuredProjects.map((project, i) => (
              <div class="stagger-item">
                <ProjectCard project={project} index={i} />
              </div>
            ))}
          </div>
        ) : (
          <p class="text-base" style="color: var(--text-muted);">
            Projects coming soon.
          </p>
        )
      }
    </section>

    <!-- Client Work -->
    <section
      id="client-work"
      class="section-reveal mb-16 md:mb-24"
      aria-labelledby="client-work-heading"
    >
      <div class="section-head">
        <span class="section-label 2xl:hidden">04</span>
        <h2
          id="client-work-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Client Work
        </h2>
      </div>
      <p class="text-sm mb-6 max-w-xl" style="color: var(--text-muted);">
        Smaller freelance builds - microsites and client projects.
      </p>
      {
        clientProjects.length > 0 && (
          <div class="client-grid">
            {clientProjects.map((project, i) => (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`client-card stagger-item${i === 0 ? " client-card--feature" : ""}`}
                data-index={String(i + 1).padStart(2, "0")}
              >
                <div class="client-card__head">
                  <span class="client-card__mark" aria-hidden="true">
                    {monogram(project.data.title)}
                  </span>
                  {project.data.year && (
                    <span class="client-card__year">{project.data.year}</span>
                  )}
                </div>
                <h3 class="client-card__title">{project.data.title}</h3>
                <p class={`client-card__desc ${i === 0 ? "line-clamp-2" : "line-clamp-3"}`}>
                  {project.data.description}
                </p>
                <span class="client-card__cta">
                  <span class="client-card__host">
                    {hostname(project.data.demoUrl)}
                  </span>
                  <svg
                    class="w-3.5 h-3.5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 17L17 7M17 7H7m10 0v10"
                    />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        )
      }
    </section>

    <!-- Blog -->
    <section id="writing" class="section-reveal mb-8" aria-labelledby="blog-heading">
      <div class="section-head">
        <span class="section-label 2xl:hidden">05</span>
        <h2
          id="blog-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Writing
        </h2>
      </div>
      {
        latestPosts.length > 0 ? (
          <div class="mb-8">
            {latestPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="post-row stagger-item">
                <time
                  class="post-row__date"
                  datetime={post.data.pubDate.toISOString()}
                >
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <div class="post-row__body">
                  <h3 class="post-row__title">{post.data.title}</h3>
                  <p class="post-row__excerpt line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
                <span class="post-row__arrow" aria-hidden="true">
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-base mb-6" style="color: var(--text-muted);">
            No posts yet.
          </p>
        )
      }
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-semibold transition-colors hover:opacity-90"
        style="color: var(--accent-text);"
      >
        View all posts
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
        >
      </a>
    </section>

    <!-- Contact -->
    <section
      id="contact"
      class="section-reveal mt-16 md:mt-24"
      aria-labelledby="contact-heading"
    >
      <div class="section-head">
        <span class="section-label 2xl:hidden">06</span>
        <h2
          id="contact-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Contact
        </h2>
      </div>
      <div class="contact-panel stagger-item">
        <p class="contact-panel__lead">
          Got a project, a role, or a question about something here? Email is the
          fastest way to reach me, and I read everything.
        </p>
        <div class="contact-panel__actions">
          <a
            href={`mailto:${EMAIL}`}
            class="btn-spring contact-panel__primary"
          >
            {EMAIL}
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          {
            RESUME_URL && (
              <a href={RESUME_URL} class="btn-spring contact-panel__secondary">
                Download CV
              </a>
            )
          }
          <a
            href={SOCIALS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-spring contact-panel__secondary"
          >
            LinkedIn
          </a>
          <a
            href={SOCIALS.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-spring contact-panel__secondary"
          >
            Telegram
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
