---
import Layout from "../layouts/Layout.astro";
import TechStack from "../components/TechStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectArchive from "../components/ProjectArchive.astro";
import Globe from "../components/Globe.astro";
import DotField from "../components/DotField.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
  EMAIL,
  LOCATION,
  NAME,
  RESUME_URL,
  SITE_TITLE,
  TIMEZONE_LABEL,
} from "../consts";
import { toArchive } from "../utils/projects";
import { readingMinutes } from "../utils/reading";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestPost = posts[0];

const allProjects = await getCollection("projects");

const featured = allProjects
  .filter((p) => p.data.featured && !p.data.clientWork)
  .sort(
    (a, b) =>
      (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
      a.data.title.localeCompare(b.data.title),
  );

/** Everything not in the featured stack; the homepage shows the newest few. */
const archive = toArchive(allProjects.filter((p) => !featured.includes(p)));
const ARCHIVE_PREVIEW = 5;

const clientCount = allProjects.filter((p) => p.data.clientWork).length;

/** Projects shipped per year, oldest first, for the bar strip in the stats card. */
const perYear = Object.entries(
  allProjects.reduce<Record<string, number>>((acc, p) => {
    if (p.data.year) acc[p.data.year] = (acc[p.data.year] ?? 0) + 1;
    return acc;
  }, {}),
).sort(([a], [b]) => a.localeCompare(b));
const maxPerYear = Math.max(...perYear.map(([, n]) => n));

const experiences = (await getCollection("experience")).sort(
  (a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime(),
);

function monthYear(date: string) {
  return new Date(date).toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
function shortDate(date: Date) {
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

const now = [
  {
    tag: "Founder",
    text: "Building Driftwatch, a breaking-change radar for third-party APIs.",
  },
  {
    tag: "Freelance",
    text: "Building web platforms, Android apps and backends for clients.",
  },
  {
    tag: "Training",
    text: "Teaching Nimzo, my from-scratch chess engine, to play past 1000 Elo.",
  },
];
---

<Layout title={SITE_TITLE} fullTitle={true} wideLayout={true}>
  <!-- ================================================================ Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <DotField />

    <h1 id="hero-title" class="hero__title" data-enter style="--d: 0">
      <span class="sr-only">{NAME}, </span>
      Software engineer
      <br />
      shipping <span class="serif-accent">real products</span>
      <br />
      &amp; <span class="serif-accent hero__accent">odd experiments.</span>
    </h1>

    <div class="hero__foot">
      <p class="hero__lead text-pretty" data-enter style="--d: 1">
        I'm <strong>Amir Aman</strong>, a software engineer in Ethiopia. I build production web apps
        with TypeScript and Next.js, Android apps with React Native, and backends in Node, Python and
        Go. Lately: MCP tooling for AI agents, a chess engine trained from scratch, and creatures that
        evolve to walk in your browser.
      </p>
      <div class="hero__actions" data-enter style="--d: 2">
        <button type="button" class="btn btn--primary" data-copy={EMAIL}>
          Copy email
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h8"></path>
          </svg>
        </button>
        <a class="btn" href="#work">
          See the work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14m-6-6 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        {
          RESUME_URL && (
            <a class="btn btn--ghost" href={RESUME_URL}>
              Download CV
            </a>
          )
        }
      </div>
    </div>
  </section>

  <div class="hero__marquee" data-enter style="--d: 3">
    <TechStack variant="marquee" />
  </div>

  <!-- =============================================================== Bento -->
  <section id="about" class="block section-reveal" aria-label="About">
    <div class="bento">
      <article class="bento__cell bento__about card spotlight tilt">
        <div class="bento__about-head">
          <div class="badge">
            <svg class="badge__ring" viewBox="0 0 120 120" aria-hidden="true">
              <defs>
                <path id="badge-path" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0"></path>
              </defs>
              <text>
                <textPath href="#badge-path" textLength="290">
                  SOFTWARE ENGINEER · FOUNDER · ETHIOPIA ·
                </textPath>
              </text>
            </svg>
            <img src="/logo.png" alt="" width="56" height="56" class="badge__avatar" />
          </div>
          <div>
            <p class="bento__name">{NAME}</p>
            <p class="section-label">Software Engineer</p>
          </div>
        </div>
        <h2 class="bento__about-title">
          I like hard problems that end up in <span class="serif-accent">someone's hands.</span>
        </h2>
        <div class="bento__about-body text-pretty">
          <p>
            I studied software engineering at Adama Science and Technology University, built
            payment-backed event platforms at iConnect, and now work independently, shipping
            for clients and for myself.
          </p>
          <p>
            I care about the boring parts that make things trustworthy: idempotency, honest
            numbers, offline-first apps, and pages that load fast on slow connections.
          </p>
        </div>
        <ul class="bento__prev" aria-label="Previously">
          <li class="section-label">Previously</li>
          {
            experiences
              .filter((e) => !e.data.current)
              .map((e) => <li>{e.data.company.split(",")[0]}</li>)
          }
        </ul>
      </article>

      <article class="bento__cell bento__world card spotlight">
        <div class="bento__world-copy">
          <p class="section-label bento__label">Local time</p>
          <p class="bento__time font-mono"><time data-clock="short">--:--</time></p>
          <p class="bento__place">{LOCATION} · {TIMEZONE_LABEL}</p>
        </div>
        <div class="bento__world-globe">
          <Globe lat={9.03} lon={38.74} label="Addis Ababa, Ethiopia" />
        </div>
        <p class="bento__world-note">
          <span class="live-dot"></span>
          Live: the dark side is where it's night right now. Drag to spin.
        </p>
      </article>

      <article class="bento__cell bento__now card spotlight tilt" data-stories>
        <div class="stories__bars" aria-hidden="true">
          {now.map(() => <span class="stories__bar"><i></i></span>)}
        </div>
        <p class="section-label bento__label">
          <span class="live-dot"></span> Now
        </p>
        <ol class="stories__list">
          {
            now.map((item, i) => (
              <li class={`stories__item${i === 0 ? " is-active" : ""}`}>
                <span class="tag">{item.tag}</span>
                <span class="stories__text">{item.text}</span>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="bento__cell bento__stats card spotlight tilt" data-count-group>
        <p class="section-label bento__label">By the numbers</p>
        <dl class="bento__numbers">
          <div>
            <dt>Projects shipped</dt>
            <dd data-count={allProjects.length}>{allProjects.length}</dd>
          </div>
          <div>
            <dt>Client builds</dt>
            <dd data-count={clientCount}>{clientCount}</dd>
          </div>
          <div>
            <dt>Essays</dt>
            <dd data-count={posts.length}>{posts.length}</dd>
          </div>
        </dl>
        <div class="years" aria-label="Projects shipped per year">
          {
            perYear.map(([year, n]) => (
              <div class="years__col" style={`--h: ${n / maxPerYear}`}>
                <span class="years__n font-mono">{n}</span>
                <span class="years__bar" />
                <span class="years__label font-mono">{year}</span>
              </div>
            ))
          }
        </div>
      </article>

      <article class="bento__cell bento__stack card spotlight">
        <p class="section-label bento__label">Toolbox</p>
        <TechStack variant="grid" />
      </article>

      {
        latestPost && (
          <a href={`/blog/${latestPost.slug}`} class="bento__cell bento__post card spotlight tilt">
            {latestPost.data.heroImage && (
              <Image
                src={latestPost.data.heroImage}
                alt=""
                class="bento__post-img"
                widths={[480, 800]}
                sizes="(min-width: 1024px) 560px, 92vw"
                loading="lazy"
              />
            )}
            <div class="bento__post-copy">
              <p class="section-label bento__label">Latest essay</p>
              <p class="bento__post-title text-balance">{latestPost.data.title}</p>
              <p class="bento__post-meta font-mono">
                <span>{shortDate(latestPost.data.pubDate)}</span>
                <span>{readingMinutes(latestPost.body)} min read</span>
              </p>
            </div>
            <span class="bento__post-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        )
      }
    </div>
  </section>

  <!-- ======================================================= Selected work -->
  <section id="work" class="block" aria-labelledby="work-title">
    <div class="section-head section-reveal">
      <div>
        <p class="section-label section-head__eyebrow">01 · Selected work</p>
        <h2 id="work-title" class="section-head__title">
          Things I've built <span class="serif-accent">and shipped.</span>
        </h2>
      </div>
      <p class="section-head__aside">
        From neural networks running in a browser tab to the queue that keeps a Telegram shop's
        inbox honest. Each one has a write-up on what was hard.
      </p>
    </div>

    <div class="work-stack">
      {featured.map((project, i) => <ProjectCard project={project} index={i} total={featured.length} />)}
    </div>
  </section>

  <!-- ============================================================ Archive -->
  <section id="archive" class="block section-reveal" aria-labelledby="archive-title">
    <div class="section-head">
      <div>
        <p class="section-label section-head__eyebrow">02 · Archive</p>
        <h2 id="archive-title" class="section-head__title">
          Everything <span class="serif-accent">else.</span>
        </h2>
      </div>
      <p class="section-head__aside">
        The latest client sites, side projects and Android apps. Smaller, but all real and
        all shipped.
      </p>
    </div>

    <ProjectArchive entries={archive} limit={ARCHIVE_PREVIEW} />

    <div class="archive-more">
      <a class="btn btn--primary" href="/projects">
        View all
        <svg class="icon-arrow-r" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- ========================================================= Experience -->
  <section id="experience" class="block section-reveal" aria-labelledby="exp-title">
    <div class="section-head">
      <div>
        <p class="section-label section-head__eyebrow">03 · Experience</p>
        <h2 id="exp-title" class="section-head__title">
          Where I've <span class="serif-accent">worked.</span>
        </h2>
      </div>
      <a class="btn" href="/experience">
        Full timeline
        <svg class="icon-arrow-r" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ol class="xp">
      {
        experiences.map((e) => (
          <li class="xp__row">
            <span class="xp__date font-mono">
              {monthYear(e.data.startDate)} — {e.data.endDate ? monthYear(e.data.endDate) : "Now"}
            </span>
            <span class="xp__role">
              {e.data.position}
              {e.data.current && <span class="live-dot" aria-label="Current role" />}
            </span>
            <span class="xp__company">{e.data.company}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============================================================ Writing -->
  <section id="writing" class="block section-reveal" aria-labelledby="writing-title">
    <div class="section-head">
      <div>
        <p class="section-label section-head__eyebrow">04 · Writing</p>
        <h2 id="writing-title" class="section-head__title">
          Notes &amp; <span class="serif-accent">opinions.</span>
        </h2>
      </div>
      <a class="btn" href="/blog">
        All writing
        <svg class="icon-arrow-r" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ul class="posts">
      {
        posts.slice(0, 4).map((post) => (
          <li>
            <a class="posts__row" href={`/blog/${post.slug}`}>
              <time class="posts__date font-mono" datetime={post.data.pubDate.toISOString()}>
                {shortDate(post.data.pubDate)}
              </time>
              <span class="posts__title text-balance">{post.data.title}</span>
              <span class="posts__read font-mono">{readingMinutes(post.body)} min</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .block {
    margin-top: clamp(6rem, 12vw, 9.5rem);
  }

  /* ------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    padding: clamp(3.5rem, 10vw, 7rem) 0 clamp(3rem, 6vw, 4.5rem);
  }
  .hero__title {
    font-size: clamp(2.6rem, 8.6vw, 6.75rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: var(--text);
  }
  .hero__title .serif-accent {
    letter-spacing: -0.025em;
  }
  .hero__accent {
    color: var(--accent-text);
  }

  .hero__foot {
    display: grid;
    gap: 2rem;
    margin-top: 2.25rem;
  }
  @media (min-width: 900px) {
    .hero__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 4rem;
    }
  }
  .hero__lead {
    max-width: 36rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    color: var(--text-muted);
  }
  .hero__lead strong {
    color: var(--text);
    font-weight: 600;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero__marquee {
    padding: 1.4rem 0;
    border-block: 1px solid var(--border);
  }

  /* ------------------------------------------------------------ Bento */
  .bento {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 680px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento__about,
    .bento__world {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .bento__about,
    .bento__world,
    .bento__now,
    .bento__stats,
    .bento__stack,
    .bento__post {
      grid-column: span 2;
    }
  }

  .bento__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .bento__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }

  /* About ------------------------------------------------------------- */
  .bento__about {
    padding: 1.75rem;
  }
  .bento__about-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* Avatar inside a slowly turning ring of text */
  .badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    flex-shrink: 0;
  }
  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .badge__ring {
      animation: spin 22s linear infinite;
    }
    .bento__about:hover .badge__ring {
      animation-duration: 6s;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .badge__avatar {
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--border-strong);
  }
  .bento__name {
    margin-bottom: 0.2rem;
    font-weight: 600;
    color: var(--text);
  }
  .bento__about-title {
    margin-top: 1.75rem;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .bento__about-title .serif-accent {
    color: var(--accent-text);
  }
  .bento__about-body {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .bento__prev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: auto;
    padding-top: 1.75rem;
    font-size: 0.85rem;
    color: var(--text);
  }
  .bento__prev li:not(:first-child)::before {
    content: "↳ ";
    color: var(--text-faint);
  }

  /* World: a night-sky card in both themes ----------------------------- */
  .bento__world {
    --text: #f4f4f5;
    --text-muted: #a1a1aa;
    --text-faint: #71717a;
    min-height: 26rem;
    overflow: hidden;
    border-color: #1d2230;
    color: var(--text);
    background:
      radial-gradient(1px 1px at 12% 18%, rgba(255, 255, 255, 0.7), transparent),
      radial-gradient(1px 1px at 28% 72%, rgba(255, 255, 255, 0.45), transparent),
      radial-gradient(1.5px 1.5px at 44% 34%, rgba(255, 255, 255, 0.6), transparent),
      radial-gradient(1px 1px at 8% 88%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1px 1px at 62% 12%, rgba(255, 255, 255, 0.55), transparent),
      radial-gradient(1px 1px at 90% 8%, rgba(255, 255, 255, 0.5), transparent),
      radial-gradient(1.5px 1.5px at 20% 50%, rgba(255, 255, 255, 0.35), transparent),
      radial-gradient(90% 80% at 75% 70%, #0d1a33 0%, #070b14 55%, #04060a 100%);
  }
  .bento__world.spotlight {
    --glare: rgba(140, 180, 255, 0.07);
    --rim: rgba(255, 255, 255, 0.5);
  }
  .bento__world-copy {
    position: relative;
    z-index: 2;
  }
  .bento__time {
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .bento__place {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .bento__world-globe {
    width: min(100%, 22rem);
    margin: 1.5rem auto 1rem;
  }
  @media (min-width: 680px) {
    .bento__world-globe {
      position: absolute;
      right: -2.5rem;
      bottom: -3rem;
      width: min(80%, 25rem);
      margin: 0;
    }
  }
  .bento__world-note {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 14rem;
    margin-top: auto;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-muted);
  }
  .bento__world-note .live-dot {
    flex-shrink: 0;
  }

  /* Now: story-style, one item in focus at a time ---------------------- */
  .stories__bars {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 1.1rem;
  }
  .stories__bar {
    flex: 1;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--border-strong);
  }
  .stories__bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: left;
  }
  .stories__bar.is-done i {
    transform: scaleX(1);
  }
  .stories__bar.is-active i {
    animation: story 5s linear forwards;
  }
  [data-stories]:hover .stories__bar.is-active i {
    animation-play-state: paused;
  }
  @keyframes story {
    to {
      transform: scaleX(1);
    }
  }
  .stories__list {
    display: grid;
    gap: 0.4rem;
  }
  .stories__item {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text);
    cursor: pointer;
    opacity: 0.42;
    transition:
      opacity 0.45s var(--ease-soft),
      background-color 0.45s var(--ease-soft),
      transform 0.6s var(--ease-spring);
  }
  .stories__item .tag {
    justify-self: start;
  }
  .stories__item.is-active {
    opacity: 1;
    background: var(--bg-subtle);
    transform: translateX(4px);
  }
  .stories__item.is-active .tag {
    border-color: var(--text);
    color: var(--text);
  }
  /* Without JS (or with reduced motion) every item is simply shown */
  [data-stories]:not(.is-live) .stories__item {
    opacity: 1;
    background: none;
    transform: none;
  }
  [data-stories]:not(.is-live) .stories__bars {
    display: none;
  }
  @media (max-width: 420px) {
    .stories__item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
  }

