---
import Layout from "../layouts/Layout.astro";
import TechStack from "../components/TechStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )
  .slice(0, 2);

const allProjects = await getCollection("projects");

const featuredProjects = allProjects
  .filter((p) => !p.data.clientWork)
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return a.data.title.localeCompare(b.data.title);
  });

const clientProjects = allProjects
  .filter((p) => p.data.clientWork)
  .sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0));

const railItems = [
  { num: "01", label: "About", id: "about" },
  { num: "02", label: "Stack", id: "stack" },
  { num: "03", label: "Work", id: "work" },
  { num: "04", label: "Client Work", id: "client-work" },
  { num: "05", label: "Writing", id: "writing" },
];
---

<Layout title="Amir - Software Engineer" wideLayout={true} railItems={railItems}>
  <div class="py-8 md:py-12">
    <!-- Hero / About -->
    <section id="about" class="mb-16 md:mb-20 animate-fade-in">
      <p class="section-label mb-4 2xl:hidden">01</p>
      <h1
        class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight mb-5"
        style="color: var(--text);"
      >
        Amir Aman
      </h1>
      <div class="w-16 h-px mb-6" style="background: var(--accent);"></div>
      <p
        class="text-xl md:text-2xl font-display font-medium mb-4 max-w-2xl"
        style="color: var(--accent-text);"
      >
        Software Engineer specializing in scalable web architectures.
      </p>
      <div
        class="max-w-2xl space-y-4 text-base md:text-lg leading-relaxed mb-8 flex flex-col"
        style="color: var(--text-muted);"
      >
        <p>
          I architect and build robust applications using Node.js, Next.js, and React. My focus is on crafting scalable backend systems, designing intuitive user experiences, and writing clean, maintainable code.
        </p>
        <p>
          Beyond web development, I have a strong interest in high-performance computing and Machine Learning. I'm currently expanding my expertise in C++ and exploring ML concepts, sharing my technical insights and discoveries on my blog.
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://www.linkedin.com/in/amiramaan/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border-2 px-6 py-2.5 text-sm font-semibold transition-all hover:scale-[1.02]"
          style="border-color: var(--accent); color: var(--accent-text); background-color: transparent;"
        >
          View LinkedIn
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>
        <a
          href="https://github.com/asgerami"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border-2 px-6 py-2.5 text-sm font-semibold transition-all hover:scale-[1.02]"
          style="border-color: var(--border); color: var(--text); background-color: var(--bg-elevated);"
        >
          View GitHub
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
        </a>
      </div>
    </section>

    <!-- Tech Stack -->
    <section
      id="stack"
      class="section-reveal mb-16 md:mb-24"
      aria-labelledby="tech-heading"
    >
      <div class="section-head">
        <span class="section-label 2xl:hidden">02</span>
        <h2
          id="tech-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Stack
        </h2>
      </div>
      <div class="stagger-item">
        <TechStack />
      </div>
    </section>

    <!-- Work -->
    <section
      id="work"
      class="section-reveal mb-16 md:mb-24"
      aria-labelledby="work-heading"
    >
      <div class="section-head">
        <span class="section-label 2xl:hidden">03</span>
        <h2
          id="work-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Work
        </h2>
      </div>
      {
        featuredProjects.length > 0 ? (
          <div
            class="flex flex-col gap-5 md:gap-0 md:divide-y"
            style="--tw-divide-opacity:1; border-color: var(--border);"
          >
            {featuredProjects.map((project, i) => (
              <div class="stagger-item">
                <ProjectCard project={project} index={i} />
              </div>
            ))}
          </div>
        ) : (
          <p class="text-base" style="color: var(--text-muted);">
            Projects coming soon.
          </p>
        )
      }
    </section>

    <!-- Client Work -->
    <section
      id="client-work"
      class="section-reveal mb-16 md:mb-24"
      aria-labelledby="client-work-heading"
    >
      <div class="section-head">
        <span class="section-label 2xl:hidden">04</span>
        <h2
          id="client-work-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Client Work
        </h2>
      </div>
      <p class="text-sm mb-2 max-w-xl" style="color: var(--text-muted);">
        Smaller freelance builds - microsites and client projects.
      </p>
      {
        clientProjects.length > 0 && (
          <div>
            {clientProjects.map((project) => (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rule-row stagger-item flex items-center justify-between gap-4 py-4 px-2 -mx-2 rounded-lg group"
              >
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3
                      class="font-display font-semibold text-base"
                      style="color: var(--text);"
                    >
                      {project.data.title}
                    </h3>
                    {project.data.year && (
                      <span
                        class="text-xs font-medium"
                        style="color: var(--text-muted);"
                      >
                        {project.data.year}
                      </span>
                    )}
                  </div>
                  <p
                    class="text-sm mt-1 line-clamp-2 max-w-xl"
                    style="color: var(--text-muted);"
                  >
                    {project.data.description}
                  </p>
                </div>
                <svg
                  class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  style="color: var(--text-muted);"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 17L17 7M17 7H7m10 0v10"
                  />
                </svg>
              </a>
            ))}
          </div>
        )
      }
    </section>

    <!-- Blog -->
    <section id="writing" class="section-reveal mb-8" aria-labelledby="blog-heading">
      <div class="section-head">
        <span class="section-label 2xl:hidden">05</span>
        <h2
          id="blog-heading"
          class="font-display text-2xl md:text-3xl font-bold"
          style="color: var(--text);"
        >
          Recent posts
        </h2>
      </div>
      {
        latestPosts.length > 0 ? (
          <div class="space-y-4 mb-6">
            {latestPosts.map((post, i) => (
              <div class="stagger-item">
                <a
                  href={`/blog/${post.slug}`}
                  class="card card-hover block p-5 md:p-6 group"
                >
                  <h3
                    class="font-display font-semibold text-lg mb-1 group-hover:opacity-90 transition-opacity"
                    style="color: var(--text);"
                  >
                    {post.data.title}
                  </h3>
                  <p
                    class="text-sm mb-3 line-clamp-2"
                    style="color: var(--text-muted);"
                  >
                    {post.data.description}
                  </p>
                  <time
                    class="text-xs font-medium"
                    style="color: var(--accent-text);"
                  >
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                </a>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-base mb-6" style="color: var(--text-muted);">
            No posts yet.
          </p>
        )
      }
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-semibold transition-colors hover:opacity-90"
        style="color: var(--accent-text);"
      >
        View all posts
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
        >
      </a>
    </section>
  </div>
</Layout>
