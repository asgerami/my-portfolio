---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { RESUME_URL } from "../consts";
import { breadcrumbs, personRef } from "../utils/schema";

const experiences = (await getCollection("experience")).sort(
  (a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime(),
);

function monthYear(dateStr: string) {
  return new Date(dateStr).toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

/** "1 yr 3 mos", counted inclusively in whole months. */
function duration(start: string, end?: string) {
  const a = new Date(start);
  const b = end ? new Date(end) : new Date();
  const months = Math.max(1, (b.getFullYear() - a.getFullYear()) * 12 + b.getMonth() - a.getMonth() + 1);
  const years = Math.floor(months / 12);
  const rest = months % 12;
  return [years && `${years} yr${years > 1 ? "s" : ""}`, rest && `${rest} mo${rest > 1 ? "s" : ""}`]
    .filter(Boolean)
    .join(" ");
}
---

<Layout
  title="Experience"
  description="Amir Aman's career so far: freelance software engineering, full-stack work at iConnect, a Smart City API internship in Adama, and mentoring Ethiopia's FIRST Global robotics team."
  wideLayout={true}
  pageType="ProfilePage"
  mainEntity={personRef}
  schema={[breadcrumbs([["Experience", "/experience"]])]}
>
  <header class="page-hero">
    <p class="section-label section-head__eyebrow" data-enter style="--d: 0">Experience</p>
    <h1 class="page-hero__title" data-enter style="--d: 1">
      Career, <span class="serif-accent">so far.</span>
    </h1>
    <p class="page-hero__lead text-pretty" data-enter style="--d: 2">
      From mentoring a national robotics team to building payment-backed platforms and shipping my
      own apps. Every role pushed me closer to the thing I like most: software that real people rely on.
    </p>
    {
      RESUME_URL && (
        <a class="btn btn--primary" href={RESUME_URL} data-enter style="--d: 3">
          Download CV
        </a>
      )
    }
  </header>

  <ol class="timeline">
    {
      experiences.map((e) => (
        <li class={`timeline__item section-reveal${e.data.current ? " is-current" : ""}`}>
          <div class="timeline__when">
            <p class="timeline__dates font-mono">
              {monthYear(e.data.startDate)} — {e.data.endDate ? monthYear(e.data.endDate) : "Present"}
            </p>
            <p class="timeline__duration font-mono">{duration(e.data.startDate, e.data.endDate)}</p>
          </div>

          <span class="timeline__node" aria-hidden="true">
            {e.data.current && <span class="live-dot" />}
          </span>

          <article class="timeline__body">
            {e.data.current && (
              <p class="timeline__now">
                <span class="live-dot" /> Current role
              </p>
            )}
            <h2 class="timeline__role">{e.data.position}</h2>
            <p class="timeline__company">{e.data.company}</p>
            <p class="timeline__desc text-pretty">{e.data.description}</p>
            {e.data.technologies && e.data.technologies.length > 0 && (
              <ul class="tag-list" aria-label="Technologies">
                {e.data.technologies.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</Layout>

<style>
  .timeline {
    position: relative;
    border-top: 1px solid var(--border);
  }
  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 860px) {
    .timeline__item {
      grid-template-columns: 15rem 2rem minmax(0, 1fr);
      gap: 2rem;
      padding: 3.5rem 0;
    }
  }

  .timeline__when {
    grid-column: 2;
  }
  @media (min-width: 860px) {
    .timeline__when {
      grid-column: 1;
      grid-row: 1;
    }
  }
  .timeline__dates {
    font-size: 0.8rem;
    color: var(--text);
  }
  .timeline__duration {
    margin-top: 0.3rem;
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .timeline__node {
    grid-column: 1;
    grid-row: 1 / span 2;
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 0.35rem;
  }
  @media (min-width: 860px) {
    .timeline__node {
      grid-column: 2;
      grid-row: 1;
    }
  }
  .timeline__node::before {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg);
  }
  .timeline__node .live-dot {
    position: absolute;
    top: 0.35rem;
    width: 0.65rem;
    height: 0.65rem;
  }
  .is-current .timeline__node::before {
    border-color: var(--accent);
  }

  .timeline__body {
    grid-column: 2;
    min-width: 0;
  }
  @media (min-width: 860px) {
    .timeline__body {
      grid-column: 3;
      grid-row: 1;
    }
  }
  .timeline__now {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: 999px;
    background: var(--accent-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .timeline__role {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .timeline__company {
    margin-top: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--text-muted);
  }
  .timeline__desc {
    max-width: 40rem;
    margin: 1.25rem 0 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
</style>
