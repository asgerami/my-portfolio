---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout
  title="Writing"
  description="Essays and notes from Amir Aman on software engineering, Go, the AI industry, and Ethiopia's infrastructure."
  wideLayout={true}
>
  <div class="py-8 md:py-12">
    <div class="section-head">
      <h1 class="font-display text-3xl md:text-4xl font-bold" style="color: var(--text);">
        Writing
      </h1>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 mb-12">
      <p class="text-base max-w-xl" style="color: var(--text-muted);">
        Thoughts, recommendations, and what I’m learning.
      </p>
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors hover:opacity-90"
        style="color: var(--accent-text);"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.503 20.752A3.25 3.25 0 1 1 3.252 17.5a3.25 3.25 0 0 1 3.251 3.252ZM3.252 10.5v3.5a6.75 6.75 0 0 1 6.75 6.752h3.5A10.25 10.25 0 0 0 3.252 10.5Zm0-6.75v3.5c7.318 0 13.25 5.932 13.25 13.25h3.5C20.002 12.06 12.442 4.5 3.252 4.5Z"
          ></path>
        </svg>
        RSS
      </a>
    </div>

    {posts.length > 0 ? (
      <div class="space-y-4">
        {posts.map((post) => (
          <article class="card card-hover">
            <a href={`/blog/${post.slug}`} class="block p-5 md:p-6 group">
              <h2 class="font-display font-semibold text-lg mb-2 group-hover:opacity-90 transition-opacity" style="color: var(--text);">
                {post.data.title}
              </h2>
              <p class="text-sm mb-4 line-clamp-2" style="color: var(--text-muted);">
                {post.data.description}
              </p>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <time class="text-xs font-medium" style="color: var(--accent-text);" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                </time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <li>
                        <span
                          class="rounded-md px-2 py-0.5 text-xs font-medium"
                          style="background: var(--accent-muted); color: var(--accent-text);"
                        >
                          #{tag}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="card p-12 text-center">
        <h2 class="font-display text-xl font-semibold mb-2" style="color: var(--text);">
          Posts coming soon
        </h2>
        <p class="text-sm" style="color: var(--text-muted);">
          I’m working on posts about software engineering and my learning journey. Check back soon.
        </p>
      </div>
    )}
  </div>
</Layout>
