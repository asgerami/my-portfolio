---
import Layout from "../../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Was hardcoded to "~3 min read" on every post regardless of length.
const words = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 220));

// Share each post under its own hero rather than the generic site card.
const ogImage = post.data.heroImage
  ? (await getImage({ src: post.data.heroImage, width: 1200, format: "png" })).src
  : undefined;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: post.data.tags,
  }}
>
  <article class="py-8 md:py-12">
    <div class="max-w-2xl">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-medium mb-8 transition-colors hover:opacity-90"
        style="color: var(--accent-text);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to blog
      </a>

      <header class="mb-10 pb-8 border-b border-[var(--border)]">
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold mb-6 leading-tight" style="color: var(--text);">
          {post.data.title}
        </h1>
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6">
          <time class="text-sm font-medium" style="color: var(--text-muted);" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </time>
          {post.data.updatedDate && post.data.updatedDate.getTime() !== post.data.pubDate.getTime() && (
            <span class="text-xs" style="color: var(--text-muted);">
              Updated {post.data.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            </span>
          )}
          {post.data.tags && post.data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li>
                  <span
                    class="rounded-md px-2 py-0.5 text-xs font-medium"
                    style="background: var(--accent-muted); color: var(--accent-text);"
                  >
                    #{tag}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <p class="text-lg leading-relaxed" style="color: var(--text-muted);">
          {post.data.description}
        </p>
      </header>

      {post.data.heroImage && (
        <div class="mb-12 rounded-2xl overflow-hidden border border-[var(--border)]">
          <Image
            src={post.data.heroImage}
            alt={post.data.heroAlt ?? post.data.title}
            widths={[640, 1024, 1400]}
            sizes="(min-width: 768px) 672px, 92vw"
            class="w-full max-h-[24rem] md:max-h-[28rem] object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="blog-content">
        <Content />
      </div>

      <footer class="mt-12 pt-8 border-t border-[var(--border)] flex items-center justify-between flex-wrap gap-4">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold transition-colors hover:opacity-90"
          style="color: var(--accent-text);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All posts
        </a>
        <span class="text-xs" style="color: var(--text-muted);">
          {readingTime} min read
        </span>
      </footer>
    </div>
  </article>
</Layout>
