---
import Layout from "../../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { NAME } from "../../consts";
import { readingMinutes } from "../../utils/reading";
import { breadcrumbs } from "../../utils/schema";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await post.render();

const readingTime = readingMinutes(post.body);

// Share each post under its own hero rather than the generic site card.
const ogImage = post.data.heroImage
  ? (await getImage({ src: post.data.heroImage, width: 1200, format: "png" })).src
  : undefined;

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: post.data.tags,
    wordCount: post.body.trim().split(/\s+/).length,
  }}
  ogImageAlt={post.data.heroAlt ?? post.data.title}
  schema={[
    breadcrumbs([
      ["Writing", "/blog"],
      [post.data.title, `/blog/${post.slug}/`],
    ]),
  ]}
>
  <div class="progress" aria-hidden="true"></div>

  <article class="post">
    <a href="/blog" class="post__back font-mono">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5m6 6-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      All writing
    </a>

    <header class="post__header">
      {
        post.data.tags && post.data.tags.length > 0 && (
          <ul class="post__tags font-mono" aria-label="Tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <h1 class="post__title text-balance" data-enter style="--d: 0">{post.data.title}</h1>
      <p class="post__lead text-pretty" data-enter style="--d: 1">{post.data.description}</p>
      <div class="post__byline" data-enter style="--d: 2">
        <img src="/logo.png" alt="" width="36" height="36" />
        <div>
          <p class="post__author">{NAME}</p>
          <p class="post__meta font-mono">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            <span>{readingTime} min read</span>
            {
              post.data.updatedDate &&
                post.data.updatedDate.getTime() !== post.data.pubDate.getTime() && (
                  <span>Updated {fmt(post.data.updatedDate)}</span>
                )
            }
          </p>
        </div>
      </div>
    </header>

    {
      post.data.heroImage && (
        <figure class="post__hero" data-enter style="--d: 3">
          <Image
            src={post.data.heroImage}
            alt={post.data.heroAlt ?? post.data.title}
            widths={[640, 1024, 1400, 1800]}
            sizes="(min-width: 1024px) 960px, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="blog-content">
      <Content />
    </div>

    <footer class="post__footer">
      <p class="post__thanks">
        Thanks for reading. If this was useful, or you think I'm wrong, <a href="#contact">tell me</a>.
      </p>
      <nav class="post__nav" aria-label="More writing">
        {
          older && (
            <a class="post__nav-link" href={`/blog/${older.slug}`}>
              <span class="section-label">Previous</span>
              <span class="post__nav-title">{older.data.title}</span>
            </a>
          )
        }
        {
          newer && (
            <a class="post__nav-link post__nav-link--next" href={`/blog/${newer.slug}`}>
              <span class="section-label">Next</span>
              <span class="post__nav-title">{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Layout>

<style>
  /* Reading progress: a scroll-driven animation, no JS. Browsers without
     scroll timelines simply don't show the bar. */
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 70;
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      animation: grow linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes grow {
    to {
      transform: scaleX(1);
    }
  }

  .post {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }
  .post__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-soft);
  }
  .post__back svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.35s var(--ease-spring);
  }
  .post__back:hover {
    color: var(--text);
  }
  .post__back:hover svg {
    transform: translateX(-3px);
  }

  .post__header {
    margin: 2.5rem 0 3rem;
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .post__tags li::before {
    content: "#";
    color: var(--text-faint);
  }
  .post__title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--text);
  }
  .post__lead {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .post__byline {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .post__byline img {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    box-shadow: 0 0 0 1px var(--border-strong);
  }
  .post__author {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* The hero breaks out of the 44rem reading column */
  .post__hero {
    /* Centred with margins, not a transform, so the entrance animation's
       transform doesn't knock it off-centre. */
    width: min(60rem, calc(100vw - 2.5rem));
    margin: 0 0 3.5rem calc(50% - min(30rem, 50vw - 1.25rem));
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
  }
  .post__hero img {
    display: block;
    width: 100%;
    max-height: 34rem;
    object-fit: cover;
  }

  .post__footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .post__thanks {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .post__thanks a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .post__nav {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .post__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .post__nav-link {
    display: grid;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1.15rem;
    background: var(--bg-elevated);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s var(--ease-soft), transform 0.45s var(--ease-spring);
  }
  .post__nav-link:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .post__nav-link--next {
    text-align: right;
  }
  @media (min-width: 640px) {
    .post__nav-link--next:only-child {
      grid-column: 2;
    }
  }
  .post__nav-title {
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }
</style>
