---
// Fonts are self-hosted rather than pulled from Google Fonts: it removes a
// render-blocking third-party stylesheet plus two DNS lookups, and the site
// keeps its typography on networks where fonts.googleapis.com is slow or blocked.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  NAME,
  ROLE,
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  EMAIL,
  SOCIALS,
  X_HANDLE,
  KNOWS_ABOUT,
} from "../consts";

export interface Props {
  title: string;
  description?: string;
  /** Use `title` verbatim instead of appending "| Amir Aman". */
  fullTitle?: boolean;
  /** Absolute or root-relative social preview image. Defaults to /og.png. */
  ogImage?: string;
  /** Renders article: OG tags and BlogPosting structured data. */
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] };
  wideLayout?: boolean;
  /** Standalone pages (app privacy policies): no site nav or footer. */
  bare?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  fullTitle = false,
  ogImage = "/og.png",
  article,
  wideLayout = false,
  bare = false,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${NAME}`;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: ogImageUrl,
      datePublished: article.publishedTime.toISOString(),
      ...(article.modifiedTime && {
        dateModified: article.modifiedTime.toISOString(),
      }),
      ...(article.tags?.length && { keywords: article.tags.join(", ") }),
      author: { "@type": "Person", name: NAME, url: SITE_URL },
      publisher: { "@type": "Person", name: NAME, url: SITE_URL },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      name: NAME,
      url: SITE_URL,
      image: new URL("/logo.png", SITE_URL).href,
      jobTitle: ROLE,
      email: `mailto:${EMAIL}`,
      knowsAbout: KNOWS_ABOUT,
      sameAs: Object.values(SOCIALS),
    };

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navLinks = [
  { href: "/#work", label: "Work", active: false },
  { href: "/experience", label: "Experience", active: path.startsWith("/experience") },
  { href: "/blog", label: "Writing", active: path.startsWith("/blog") },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={NAME} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#09090a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f6f3" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
        )}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content={X_HANDLE} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${NAME} — Writing`}
      href={new URL("/rss.xml", SITE_URL).href}
    />

    {!bare && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )}

    <ClientRouter />

    <script is:inline>
      (function () {
        var root = document.documentElement;

        function preferredTheme() {
          try {
            var stored = localStorage.getItem("theme");
            if (stored === "light" || stored === "dark") return stored;
          } catch (e) {}
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        function applyTheme(theme) {
          root.classList.toggle("dark", theme !== "light");
        }

        /* Scroll-reveal capability flag.
           Only opt into the JS-driven hidden state when the browser cannot do
           native scroll-driven animations. With no JS (or no support for
           either) the class is never added and all content renders visible. */
        var hasViewTimeline =
          typeof CSS !== "undefined" &&
          typeof CSS.supports === "function" &&
          CSS.supports("animation-timeline: view()");

        function prefersReducedMotion() {
          return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        }

        function applyRevealMode() {
          root.classList.toggle("js-reveal", !hasViewTimeline && !prefersReducedMotion());
        }

        /* Runs before first paint, and again after every client-side swap
           (Astro's ClientRouter replaces every attribute on <html>). */
        applyTheme(preferredTheme());
        applyRevealMode();

        if (window.__portfolioBooted) return;
        window.__portfolioBooted = true;

        document.addEventListener("astro:after-swap", function () {
          applyTheme(preferredTheme());
          applyRevealMode();
        });

        document.addEventListener("click", function (event) {
          var target = event.target;
          var button = target && target.closest ? target.closest("#theme-toggle") : null;
          if (!button) return;

          var next = root.classList.contains("dark") ? "light" : "dark";
          function commit() {
            applyTheme(next);
            try {
              localStorage.setItem("theme", next);
            } catch (e) {}
          }

          if (typeof document.startViewTransition !== "function" || prefersReducedMotion()) {
            commit();
            return;
          }

          /* Radial reveal originating at the click point. Keyboard activation
             (and programmatic clicks from the command palette) report
             clientX/Y of 0, so fall back to the button's centre. */
          var rect = button.getBoundingClientRect();
          var x = event.clientX || rect.left + rect.width / 2;
          var y = event.clientY || rect.top + rect.height / 2;
          var radius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y)
          );

          root.style.setProperty("--theme-x", x + "px");
          root.style.setProperty("--theme-y", y + "px");
          root.style.setProperty("--theme-r", radius + "px");
          root.setAttribute("data-theme-transition", "");

          var transition = document.startViewTransition(commit);
          transition.finished
            .catch(function () {})
            .then(function () {
              root.removeAttribute("data-theme-transition");
            });
        });
      })();
    </script>
    <script src="../scripts/performance.js"></script>
    {!bare && <script src="../scripts/site.ts"></script>}
  </head>
  <body class="min-h-screen flex flex-col" id="top">
    {!bare && (
      <>
        <a href="#main" class="skip-link">Skip to content</a>
        <header class="site-header">
          <nav class="site-nav" aria-label="Main">
            <a href="/" class="site-nav__brand" aria-label={`${NAME}, home`}>
              <img src="/logo.png" alt="" width="32" height="32" loading="eager" decoding="async" />
              <span class="site-nav__name">{NAME}</span>
            </a>

            <ul class="site-nav__links">
              {navLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={link.active ? "page" : undefined}>{link.label}</a>
                </li>
              ))}
            </ul>

            <div class="site-nav__tools">
              <button type="button" class="site-nav__search" data-cmdk-open aria-label="Open command menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
                </svg>
                <kbd data-mod-key>⌘K</kbd>
              </button>
              <button id="theme-toggle" type="button" class="site-nav__icon" aria-label="Toggle theme">
                <svg class="hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"></path>
                </svg>
                <svg class="block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
          </nav>
        </header>
      </>
    )}

    <div class={`${wideLayout ? "max-w-[72rem]" : "max-w-[44rem]"} mx-auto w-full px-5 sm:px-8 flex-1`}>
      <main id="main">
        <slot />
      </main>
    </div>

    {!bare && (
      <>
        <SiteFooter />
        <CommandPalette />
        <div id="toast" class="toast" role="status" aria-live="polite"></div>
      </>
    )}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--accent-solid);
    color: var(--on-accent-solid);
    font-size: 0.85rem;
    font-weight: 600;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    padding: 0.75rem 1.25rem;
  }
  /* Frosted band that fades out downward instead of ending on a hard edge */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0 0 -1.5rem;
    z-index: -1;
    background: linear-gradient(to bottom, var(--bg) 35%, color-mix(in srgb, var(--bg) 0%, transparent));
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .site-header {
      padding: 1rem 2rem;
    }
  }

  .site-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    max-width: 68rem;
    margin: 0 auto;
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    justify-self: start;
    text-decoration: none;
    color: var(--text);
  }
  .site-nav__brand img {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    box-shadow: 0 0 0 1px var(--border-strong);
    transition: transform 0.5s var(--ease-spring);
  }
  .site-nav__brand:hover img {
    transform: rotate(-8deg) scale(1.06);
  }
  .site-nav__name {
    display: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) {
    .site-nav__name {
      display: inline;
    }
  }

  .site-nav__links {
    display: flex;
    gap: 0.15rem;
    padding: 0.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: var(--shadow-card);
  }
  .site-nav__links a {
    display: block;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-soft), background-color 0.2s var(--ease-soft);
  }
  @media (min-width: 480px) {
    .site-nav__links a {
      padding: 0.45rem 1rem;
    }
  }
  .site-nav__links a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .site-nav__links a[aria-current="page"] {
    color: var(--on-accent-solid);
    background: var(--accent-solid);
  }

  .site-nav__tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
  }
  .site-nav__search,
  .site-nav__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 2.4rem;
    min-width: 2.4rem;
    padding: 0 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-soft),
      border-color 0.2s var(--ease-soft),
      transform 0.45s var(--ease-spring);
  }
  .site-nav__search:hover,
  .site-nav__icon:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .site-nav__icon:active,
  .site-nav__search:active {
    transform: scale(0.94);
  }
  .site-nav__search svg,
  .site-nav__icon svg {
    width: 1rem;
    height: 1rem;
  }
  /* Too tight beside three links on small phones; the palette is mainly a
     keyboard feature, and every entry in it is reachable from the page. */
  @media (max-width: 419px) {
    .site-nav__search {
      display: none;
    }
  }
  .site-nav__search kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
  }
  @media (min-width: 640px) {
    .site-nav__search {
      padding: 0 0.75rem;
    }
    /* Too tight beside three links on small phones; the palette is mainly a
     keyboard feature, and every entry in it is reachable from the page. */
  @media (max-width: 419px) {
    .site-nav__search {
      display: none;
    }
  }
  .site-nav__search kbd {
      display: inline;
    }
  }
</style>
