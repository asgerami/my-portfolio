---
// Fonts are self-hosted rather than pulled from Google Fonts: it removes a
// render-blocking third-party stylesheet plus two DNS lookups, and the site
// keeps its typography on networks where fonts.googleapis.com is slow or blocked.
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PerformanceMonitor from "../components/PerformanceMonitor.astro";
import {
  NAME,
  SHORT_NAME,
  ROLE,
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  EMAIL,
  SOCIALS,
  X_HANDLE,
  KNOWS_ABOUT,
} from "../consts";

export interface Props {
  title: string;
  description?: string;
  /** Use `title` verbatim instead of appending "| Amir Aman". */
  fullTitle?: boolean;
  /** Absolute or root-relative social preview image. Defaults to /og.png. */
  ogImage?: string;
  /** Renders article: OG tags and BlogPosting structured data. */
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] };
  wideLayout?: boolean;
  railItems?: { num: string; label: string; id: string }[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  fullTitle = false,
  ogImage = "/og.png",
  article,
  wideLayout = false,
  railItems = [],
} = Astro.props;

// One title shape for the whole site. Previously every page appended a second
// "| Software Engineer" onto a title that already contained it.
const pageTitle = fullTitle ? title : `${title} | ${NAME}`;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: ogImageUrl,
      datePublished: article.publishedTime.toISOString(),
      ...(article.modifiedTime && {
        dateModified: article.modifiedTime.toISOString(),
      }),
      ...(article.tags?.length && { keywords: article.tags.join(", ") }),
      author: { "@type": "Person", name: NAME, url: SITE_URL },
      publisher: { "@type": "Person", name: NAME, url: SITE_URL },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      name: NAME,
      url: SITE_URL,
      image: new URL("/logo.png", SITE_URL).href,
      jobTitle: ROLE,
      email: `mailto:${EMAIL}`,
      knowsAbout: KNOWS_ABOUT,
      sameAs: Object.values(SOCIALS),
    };

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/experience", label: "Experience" },
  { href: "/blog", label: "Writing" },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={NAME} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Social preview. Without these, every link shared to LinkedIn, X or
         Telegram rendered as a bare URL with no title, blurb or image. -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
        )}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content={X_HANDLE} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${NAME} — Writing`}
      href={new URL("/rss.xml", SITE_URL).href}
    />

    <link rel="prefetch" href="/experience" />
    <link rel="prefetch" href="/blog" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <ClientRouter />

    <script is:inline>
      (function () {
        var root = document.documentElement;

        function preferredTheme() {
          try {
            var stored = localStorage.getItem("theme");
            if (stored === "light" || stored === "dark") return stored;
          } catch (e) {}
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        function applyTheme(theme) {
          root.classList.toggle("dark", theme !== "light");
        }

        /* Scroll-reveal capability flag.
           Only opt into the JS-driven hidden state when the browser cannot do
           native scroll-driven animations. With no JS (or no support for
           either) the class is never added and all content renders visible. */
        var hasViewTimeline =
          typeof CSS !== "undefined" &&
          typeof CSS.supports === "function" &&
          CSS.supports("animation-timeline: view()");

        function prefersReducedMotion() {
          return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        }

        function applyRevealMode() {
          root.classList.toggle("js-reveal", !hasViewTimeline && !prefersReducedMotion());
        }

        /* Runs before first paint, and again after every client-side swap
           (Astro's ClientRouter replaces every attribute on <html>). */
        applyTheme(preferredTheme());
        applyRevealMode();

        if (window.__portfolioBooted) return;
        window.__portfolioBooted = true;

        document.addEventListener("astro:after-swap", function () {
          applyTheme(preferredTheme());
          applyRevealMode();
        });

        document.addEventListener("click", function (event) {
          var target = event.target;
          var button = target && target.closest ? target.closest("#theme-toggle") : null;
          if (!button) return;

          var next = root.classList.contains("dark") ? "light" : "dark";
          function commit() {
            applyTheme(next);
            try {
              localStorage.setItem("theme", next);
            } catch (e) {}
          }

          if (typeof document.startViewTransition !== "function" || prefersReducedMotion()) {
            commit();
            return;
          }

          /* Radial reveal originating at the click point. Keyboard activation
             reports clientX/Y of 0, so fall back to the button's centre. */
          var rect = button.getBoundingClientRect();
          var x = event.clientX || rect.left + rect.width / 2;
          var y = event.clientY || rect.top + rect.height / 2;
          var radius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y)
          );

          root.style.setProperty("--theme-x", x + "px");
          root.style.setProperty("--theme-y", y + "px");
          root.style.setProperty("--theme-r", radius + "px");
          root.setAttribute("data-theme-transition", "");

          var transition = document.startViewTransition(commit);
          transition.finished
            .catch(function () {})
            .then(function () {
              root.removeAttribute("data-theme-transition");
            });
        });
      })();
    </script>
    <script src="../scripts/performance.js"></script>
  </head>
  <body class="min-h-screen flex flex-col" id="body">
    {railItems.length > 0 && (
      <nav class="index-rail hidden 2xl:flex" aria-label="Section index">
        {railItems.map((item) => (
          <a href={`#${item.id}`} class="index-rail__item" data-rail-target={item.id}>
            <span class="index-rail__num">{item.num}</span>
            <span class="index-rail__label">{item.label}</span>
          </a>
        ))}
      </nav>
    )}
    <div class={`${wideLayout ? "max-w-5xl" : "max-w-2xl"} mx-auto w-full px-4 sm:px-6 lg:px-8 flex-1`}>
      <!-- Nav -->
      <header class="sticky top-0 z-50 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 pt-4 pb-2 md:pt-6">
        <nav
          class="site-nav flex items-center justify-between rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)]/80 backdrop-blur-xl px-4 py-3"
          aria-label="Main"
        >
          <a href="/" class="flex items-center gap-2 rounded-lg">
            <img
              src="/logo.png"
              alt={NAME}
              class="w-9 h-9 md:w-10 md:h-10 rounded-full object-cover ring-2 ring-[var(--border)]"
              width="40"
              height="40"
              loading="eager"
              decoding="async"
            />
            <span class="font-display font-semibold text-sm md:text-base hidden sm:inline" style="color: var(--text);">{SHORT_NAME}</span>
          </a>
          <div class="flex items-center gap-1 sm:gap-2">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class="nav-link font-display text-sm font-medium px-3 py-2 rounded-lg hover:bg-[var(--accent-muted)]"
              >
                {link.label}
              </a>
            ))}
            <button
              id="theme-toggle"
              class="p-2 rounded-lg hover:bg-[var(--accent-muted)] touch-manipulation"
              aria-label="Toggle theme"
            >
              <svg id="sun-icon" class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20" style="color: var(--text);">
                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
              </svg>
              <svg id="moon-icon" class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20" style="color: var(--text);">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
              </svg>
            </button>
          </div>
        </nav>
      </header>

      <main class="pt-2">
        <slot />
      </main>

      <!-- Footer -->
      <footer
        class="mt-16 md:mt-24 py-8 border-t border-[var(--border)] animate-fade-in"
      >
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div class="flex flex-col items-center sm:items-start gap-1">
            <a
              href={`mailto:${EMAIL}`}
              class="text-sm font-semibold transition-colors hover:opacity-90"
              style="color: var(--accent-text);">{EMAIL}</a
            >
            <p class="text-sm font-medium" style="color: var(--text-muted);">
              © {new Date().getFullYear()} asgerami.com
            </p>
          </div>
          <div class="flex items-center gap-6">
            <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="transition-transform hover:scale-110" aria-label="GitHub" style="color: var(--text-muted);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
            </a>
            <a href={SOCIALS.x} target="_blank" rel="noopener noreferrer" class="transition-transform hover:scale-110" aria-label="X" style="color: var(--text-muted);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
            </a>
            <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" class="transition-transform hover:scale-110" aria-label="LinkedIn" style="color: var(--text-muted);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
            </a>
            <a href={SOCIALS.telegram} target="_blank" rel="noopener noreferrer" class="transition-transform hover:scale-110" aria-label="Telegram" style="color: var(--text-muted);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" /></svg>
            </a>
            <a href={`mailto:${EMAIL}`} class="transition-transform hover:scale-110" aria-label="Email" style="color: var(--text-muted);">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </a>
          </div>
        </div>
      </footer>

      <PerformanceMonitor />
    </div>
  </body>
</html>
