---
/**
 * ⌘K / Ctrl+K command palette: the native <dialog> shell only.
 *
 * Entries come from /search.json (src/utils/palette.ts) and are built by
 * site.ts the first time the palette opens: links as <a> elements (so they
 * work with the ClientRouter and open in new tabs normally), actions as
 * <button>s. Keeping them out of the page keeps every page's HTML lean. The
 * <dialog> brings focus trapping, Escape and the backdrop for free.
 */
---

<dialog id="cmdk" class="cmdk" aria-label="Command menu">
  <div class="cmdk__panel">
    <div class="cmdk__search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
      </svg>
      <input
        id="cmdk-input"
        type="text"
        placeholder="Search projects, posts, actions…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
      />
      <kbd class="cmdk__kbd">esc</kbd>
    </div>

    <div id="cmdk-list" class="cmdk__list" role="listbox" aria-label="Commands">
      <p class="cmdk__empty" hidden>Nothing matches that. Try “Go” or “chess”.</p>
    </div>

    <footer class="cmdk__footer" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span class="cmdk__footer-brand">www.asgerami.com</span>
    </footer>
  </div>
</dialog>

<style is:global>
  /* Global: the entries are created by site.ts and carry no scope class.
     Every selector is namespaced under .cmdk. */
  .cmdk {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 1.25rem;
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--text) 4%, transparent),
      0 40px 80px -24px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .cmdk[open] {
    display: flex;
    animation: cmdk-in 0.32s var(--ease-spring);
  }
  .cmdk::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  @keyframes cmdk-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.97);
    }
  }

  .cmdk__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .cmdk__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .cmdk__search svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--text-faint);
  }
  .cmdk__search input {
    flex: 1;
    min-width: 0;
    height: 3.5rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 1rem;
    outline: none;
  }
  .cmdk__search input::placeholder {
    color: var(--text-faint);
  }

  .cmdk__list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
  }
  .cmdk__group + .cmdk__group {
    margin-top: 0.35rem;
  }
  .cmdk__group-title {
    padding: 0.6rem 0.75rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .cmdk__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem 0.75rem;
    border: 0;
    border-radius: 0.7rem;
    background: transparent;
    color: var(--text);
    font-size: 0.9rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .cmdk__item[aria-selected="true"] {
    background: var(--bg-subtle);
  }
  .cmdk__item[aria-selected="true"] .cmdk__go {
    opacity: 1;
    transform: none;
    color: var(--accent-text);
  }
  .cmdk__label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmdk__hint {
    max-width: 40%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .cmdk__go {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s var(--ease-soft), transform 0.3s var(--ease-spring);
  }
  .cmdk__empty {
    padding: 2.5rem 1rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .cmdk__footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
  }
  .cmdk__footer-brand {
    margin-left: auto;
  }
  .cmdk kbd,
  .cmdk__kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    margin-right: 0.2rem;
    padding: 0 0.3rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.35rem;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }
  @media (max-width: 480px) {
    .cmdk {
      margin-top: 4.5rem;
    }
    .cmdk__footer span:not(.cmdk__footer-brand) {
      display: none;
    }
  }
</style>
