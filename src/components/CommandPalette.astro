---
/**
 * ⌘K / Ctrl+K command palette.
 *
 * Every entry is real markup rendered at build time: links are <a> elements
 * (so they work with the ClientRouter and open in new tabs normally) and
 * actions are <button>s. The script only filters, moves the highlight and
 * opens/closes the native <dialog>, which brings focus trapping, Escape and
 * the backdrop for free.
 */
import { getCollection } from "astro:content";
import { EMAIL, SOCIALS } from "../consts";
import { hasCaseStudy } from "../utils/projects";

type Item =
  | { kind: "link"; label: string; href: string; hint?: string; external?: boolean; keywords?: string }
  | { kind: "action"; label: string; action: string; hint?: string; keywords?: string };

const projects = (await getCollection("projects"))
  .filter((p) => !p.data.clientWork)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title));

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const groups: { title: string; items: Item[] }[] = [
  {
    title: "Navigate",
    items: [
      { kind: "link", label: "Home", href: "/", keywords: "index start" },
      { kind: "link", label: "Selected work", href: "/#work", keywords: "projects portfolio" },
      { kind: "link", label: "All projects", href: "/projects", keywords: "archive client freelance apps work" },
      { kind: "link", label: "Experience", href: "/experience", keywords: "career cv resume jobs" },
      { kind: "link", label: "Writing", href: "/blog", keywords: "blog posts essays articles" },
    ],
  },
  {
    title: "Actions",
    items: [
      { kind: "action", label: "Copy email address", action: "copy-email", hint: EMAIL, keywords: "contact mail hire" },
      { kind: "action", label: "Toggle theme", action: "toggle-theme", hint: "Light / Dark", keywords: "dark light mode" },
      { kind: "link", label: "Send an email", href: `mailto:${EMAIL}`, keywords: "contact hire" },
    ],
  },
  {
    title: "Projects",
    items: projects.map((p) => {
      const caseStudy = hasCaseStudy(p.body) ? `/projects/${p.slug}/` : null;
      const href = caseStudy ?? p.data.demoUrl ?? p.data.githubUrl ?? "/projects";
      return {
        kind: "link" as const,
        label: p.data.title,
        href,
        external: !caseStudy && href.startsWith("http"),
        hint: p.data.year,
        keywords: [...(p.data.techStack ?? []), p.data.description].join(" "),
      };
    }),
  },
  {
    title: "Writing",
    items: posts.map((post) => ({
      kind: "link" as const,
      label: post.data.title,
      href: `/blog/${post.slug}`,
      hint: String(post.data.pubDate.getFullYear()),
      keywords: [...(post.data.tags ?? []), post.data.description].join(" "),
    })),
  },
  {
    title: "Elsewhere",
    items: [
      { kind: "link", label: "GitHub", href: SOCIALS.github, external: true, hint: "@asgerami" },
      { kind: "link", label: "X / Twitter", href: SOCIALS.x, external: true, hint: "@asgerami" },
      { kind: "link", label: "LinkedIn", href: SOCIALS.linkedin, external: true },
      { kind: "link", label: "Telegram", href: SOCIALS.telegram, external: true },
      { kind: "link", label: "RSS feed", href: "/rss.xml", keywords: "subscribe feed" },
    ],
  },
];
---

<dialog id="cmdk" class="cmdk" aria-label="Command menu">
  <div class="cmdk__panel">
    <div class="cmdk__search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
      </svg>
      <input
        id="cmdk-input"
        type="text"
        placeholder="Search projects, posts, actions…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
      />
      <kbd class="cmdk__kbd">esc</kbd>
    </div>

    <div id="cmdk-list" class="cmdk__list" role="listbox" aria-label="Commands">
      {
        groups.map((group) => (
          <div class="cmdk__group" role="group" aria-label={group.title}>
            <p class="cmdk__group-title" aria-hidden="true">{group.title}</p>
            {group.items.map((item) =>
              item.kind === "link" ? (
                <a
                  class="cmdk__item"
                  role="option"
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  data-search={`${item.label} ${item.keywords ?? ""} ${group.title}`.toLowerCase()}
                  tabindex="-1"
                >
                  <span class="cmdk__label">{item.label}</span>
                  {item.hint && <span class="cmdk__hint">{item.hint}</span>}
                  <svg class="cmdk__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    {item.external ? (
                      <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
                    ) : (
                      <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    )}
                  </svg>
                </a>
              ) : (
                <button
                  type="button"
                  class="cmdk__item"
                  role="option"
                  data-action={item.action}
                  data-search={`${item.label} ${item.keywords ?? ""} ${group.title}`.toLowerCase()}
                  tabindex="-1"
                >
                  <span class="cmdk__label">{item.label}</span>
                  {item.hint && <span class="cmdk__hint">{item.hint}</span>}
                  <svg class="cmdk__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 10 4 15l5 5M20 4v7a4 4 0 0 1-4 4H4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              ),
            )}
          </div>
        ))
      }
      <p class="cmdk__empty" hidden>Nothing matches that. Try “Go” or “chess”.</p>
    </div>

    <footer class="cmdk__footer" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span class="cmdk__footer-brand">asgerami.com</span>
    </footer>
  </div>
</dialog>

<style>
  .cmdk {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 1.25rem;
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--text) 4%, transparent),
      0 40px 80px -24px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .cmdk[open] {
    display: flex;
    animation: cmdk-in 0.32s var(--ease-spring);
  }
  .cmdk::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  @keyframes cmdk-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.97);
    }
  }

  .cmdk__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .cmdk__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .cmdk__search svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--text-faint);
  }
  .cmdk__search input {
    flex: 1;
    min-width: 0;
    height: 3.5rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 1rem;
    outline: none;
  }
  .cmdk__search input::placeholder {
    color: var(--text-faint);
  }

  .cmdk__list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
  }
  .cmdk__group + .cmdk__group {
    margin-top: 0.35rem;
  }
  .cmdk__group-title {
    padding: 0.6rem 0.75rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .cmdk__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem 0.75rem;
    border: 0;
    border-radius: 0.7rem;
    background: transparent;
    color: var(--text);
    font-size: 0.9rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .cmdk__item[aria-selected="true"] {
    background: var(--bg-subtle);
  }
  .cmdk__item[aria-selected="true"] .cmdk__go {
    opacity: 1;
    transform: none;
    color: var(--accent-text);
  }
  .cmdk__label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmdk__hint {
    max-width: 40%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .cmdk__go {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s var(--ease-soft), transform 0.3s var(--ease-spring);
  }
  .cmdk__empty {
    padding: 2.5rem 1rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .cmdk__footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
  }
  .cmdk__footer-brand {
    margin-left: auto;
  }
  kbd,
  .cmdk__kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    margin-right: 0.2rem;
    padding: 0 0.3rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.35rem;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }
  @media (max-width: 480px) {
    .cmdk {
      margin-top: 4.5rem;
    }
    .cmdk__footer span:not(.cmdk__footer-brand) {
      display: none;
    }
  }
</style>
