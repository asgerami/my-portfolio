---
/**
 * Tech stack grid.
 *
 * Icons come from the `simple-icons` package and are inlined as SVG at build
 * time - no runtime network requests, no CDN. Simple Icons ships single-colour
 * brand marks, so every glyph is filled with `currentColor` and inherits the
 * design-system colours (--text-muted, shifting to --accent on hover).
 *
 * The import is resolved during the build (Astro frontmatter runs server-side),
 * so none of the package reaches the client bundle - only the path strings
 * embedded in the HTML.
 *
 * Every mark carries a visible label. Names used to live only in a `title`
 * attribute, which meant that on a phone - where there is no hover - the whole
 * section was a grid of unidentifiable grey glyphs. The list is also kept to
 * the things worth being asked about in an interview; tooling like Git and
 * Vercel only diluted the signal.
 */
import {
  siReact,
  siNextdotjs,
  siTypescript,
  siNodedotjs,
  siExpress,
  siPostgresql,
  siMongodb,
  siPrisma,
  siTailwindcss,
  siGo,
  siPython,
  siDocker,
} from "simple-icons";

export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

type Icon = { title: string; path: string };

const tech: { name: string; icon: Icon }[] = [
  { name: "TypeScript", icon: siTypescript },
  { name: "React", icon: siReact },
  { name: "Next.js", icon: siNextdotjs },
  { name: "Node.js", icon: siNodedotjs },
  { name: "Express", icon: siExpress },
  { name: "PostgreSQL", icon: siPostgresql },
  { name: "MongoDB", icon: siMongodb },
  { name: "Prisma", icon: siPrisma },
  { name: "Tailwind", icon: siTailwindcss },
  { name: "Go", icon: siGo },
  { name: "Python", icon: siPython },
  { name: "Docker", icon: siDocker },
];
---

<div class={`tech-shell ${className}`}>
  <ul class="tech-grid" aria-label="Tech stack">
    {
      tech.map((t) => (
        <li class="tech-cell">
          <span class="tech-icon">
            <svg
              class="tech-icon__svg"
              role="img"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d={t.icon.path} />
            </svg>
          </span>
          <span class="tech-name">{t.name}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* The grid sizes itself against its own container, not the viewport. */
  .tech-shell {
    container-type: inline-size;
    container-name: tech;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.25rem, 1fr));
    gap: 1.25rem 0.75rem;
    padding: 0.5rem 0;
    margin: 0;
    list-style: none;
  }

  @container tech (min-width: 30rem) {
    .tech-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.6rem 1rem;
    }
  }

  .tech-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem;
    text-align: center;
  }

  .tech-icon {
    display: inline-flex;
    color: var(--text-muted);
    transition:
      color 0.25s var(--ease-soft),
      opacity 0.25s var(--ease-soft),
      transform 0.45s var(--ease-spring);
  }

  .tech-icon__svg {
    width: 2rem;
    height: 2rem;
    display: block;
  }

  @container tech (min-width: 30rem) {
    .tech-icon__svg {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  .tech-name {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--text-muted);
    transition:
      color 0.25s var(--ease-soft),
      opacity 0.25s var(--ease-soft);
  }

  /* :has() - the grid recedes around whichever mark is being pointed at */
  .tech-grid:has(.tech-cell:hover) .tech-cell:not(:hover) .tech-icon,
  .tech-grid:has(.tech-cell:hover) .tech-cell:not(:hover) .tech-name {
    opacity: 0.4;
  }

  @media (hover: hover) and (pointer: fine) {
    .tech-cell:hover .tech-icon {
      color: var(--accent);
      transform: translateY(-3px) scale(1.08);
    }
    .tech-cell:hover .tech-name {
      color: var(--accent-text);
    }
  }
</style>
