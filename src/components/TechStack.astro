---
/**
 * Two renderings of the same stack list (src/utils/stack.ts):
 *
 * - "marquee": an endless, edge-faded ticker. The list is rendered twice and
 *   the track slides by exactly half its width, so the loop is seamless. The
 *   duplicate is aria-hidden; with reduced motion it simply wraps statically.
 * - "grid": labelled icons for the bento card. Every mark carries a visible
 *   name - on a phone there is no hover to reveal a tooltip.
 */
import { STACK } from "../utils/stack";

export interface Props {
  variant?: "marquee" | "grid";
}
const { variant = "grid" } = Astro.props;
---

{
  variant === "marquee" ? (
    <div class="marquee" role="region" aria-label="Tech I work with">
      <div class="marquee__track">
        {[0, 1].map((copy) => (
          <ul class="marquee__list" aria-hidden={copy === 1 ? "true" : undefined}>
            {STACK.map((t) => (
              <li class="marquee__item">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={t.path} />
                </svg>
                {t.name}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  ) : (
    <ul class="stack-grid" aria-label="Tech stack">
      {STACK.slice(0, 12).map((t) => (
        <li class="stack-grid__cell" title={t.name}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={t.path} />
          </svg>
          <span>{t.name}</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marquee 48s linear infinite;
    }
    .marquee:hover .marquee__track {
      animation-play-state: paused;
    }
  }
  .marquee__list {
    display: flex;
    flex-shrink: 0;
    gap: 2.75rem;
    padding-right: 2.75rem;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--text-muted);
    transition: color 0.2s var(--ease-soft);
  }
  .marquee__item:hover {
    color: var(--text);
  }
  .marquee__item svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee__track,
    .marquee__list {
      flex-wrap: wrap;
      width: auto;
      row-gap: 1rem;
    }
    .marquee__list[aria-hidden] {
      display: none;
    }
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .stack-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .stack-grid__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.85rem 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: var(--bg);
    color: var(--text-muted);
    transition:
      color 0.2s var(--ease-soft),
      border-color 0.2s var(--ease-soft),
      transform 0.45s var(--ease-spring);
  }
  .stack-grid__cell svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .stack-grid__cell span {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.02em;
  }
  @media (hover: hover) and (pointer: fine) {
    .stack-grid__cell:hover {
      color: var(--text);
      border-color: var(--border-strong);
      transform: translateY(-3px);
    }
  }
</style>
