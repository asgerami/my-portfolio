---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { hasCaseStudy } from "../utils/projects";

export interface Props {
  project: CollectionEntry<"projects">;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { data } = project;

const imageUrl = data.image || null;
/** Projects with a real write-up get a case-study page; the rest link straight out. */
const caseStudyUrl = hasCaseStudy(project.body)
  ? `/projects/${project.slug}/`
  : null;
/** The headline goes inward when there is something to read, outward otherwise. */
const linkUrl = caseStudyUrl || data.demoUrl || data.githubUrl;
/** The framed screenshot always points at the live thing, never the write-up. */
const frameUrl = data.demoUrl || data.githubUrl;
const isEven = index % 2 === 0;
const num = String(index + 1).padStart(2, "0");

/** Address shown in the frame's chrome: the live host, or the repo path. */
function addressBar() {
  if (data.demoUrl) {
    try {
      const url = new URL(data.demoUrl);
      // Keep the path for project sites hosted under a shared domain, where
      // the bare host ("asgerami.github.io") does not identify the project.
      return url.hostname.replace(/^www\./, "") + url.pathname.replace(/\/$/, "");
    } catch {
      return data.demoUrl;
    }
  }
  if (data.githubUrl) {
    try {
      return "github.com" + new URL(data.githubUrl).pathname;
    } catch {
      return data.githubUrl;
    }
  }
  return "";
}

/** Kicker line: what you did and when, then what the thing currently is. */
const meta = [
  data.role,
  data.year,
  data.demoUrl && "Live",
  data.githubUrl && "Open source",
]
  .filter(Boolean)
  .join(" · ");
---

<div class="work-shell">
  <article class={`work-item ${isEven ? "is-left" : "is-right"}`}>
    <div class="work-item__media">
      {
        imageUrl ? (
          <a
            class="work-frame"
            href={frameUrl}
            target={frameUrl ? "_blank" : undefined}
            rel={frameUrl ? "noopener noreferrer" : undefined}
            tabindex="-1"
            aria-hidden="true"
          >
            <span class="work-frame__bar">
              <span class="work-frame__dots" aria-hidden="true">
                <i /> <i /> <i />
              </span>
              <span class="work-frame__url">{addressBar()}</span>
            </span>
            <span class="work-frame__shot">
              {/* astro:assets emits resized WebP variants and stamps intrinsic
                  width/height, so the frame reserves its space before the image
                  lands instead of shifting the page. */}
              <Image
                src={imageUrl}
                alt={`${data.title} screenshot`}
                widths={[480, 768, 1120]}
                sizes="(min-width: 1024px) 620px, (min-width: 640px) 60vw, 92vw"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="work-frame__sheen" aria-hidden="true" />
          </a>
        ) : (
          <div class="work-frame work-frame--empty">
            <span class="work-frame__bar">
              <span class="work-frame__dots" aria-hidden="true">
                <i /> <i /> <i />
              </span>
              <span class="work-frame__url">{addressBar()}</span>
            </span>
            <span class="work-frame__shot work-frame__shot--empty">
              <span class="work-frame__mono">{data.title.charAt(0)}</span>
            </span>
          </div>
        )
      }
    </div>

    <div class="work-item__body">
      <span class="work-item__tick" aria-hidden="true"></span>
      <p class="work-item__kicker">
        <span class="work-item__num">{num}</span>
        {meta && <span class="work-item__status">{meta}</span>}
      </p>

      <h3 class="work-item__title">
        {
          linkUrl ? (
            <a
              href={linkUrl}
              target={caseStudyUrl ? undefined : "_blank"}
              rel={caseStudyUrl ? undefined : "noopener noreferrer"}
            >
              {data.title}
            </a>
          ) : (
            data.title
          )
        }
      </h3>

      <p class="work-item__desc">{data.description}</p>

      {
        data.techStack && data.techStack.length > 0 && (
          <ul class="work-item__tech" aria-label="Tech stack">
            {data.techStack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        )
      }

      <div class="work-item__links">
        {
          caseStudyUrl && (
            <a class="work-item__link work-item__link--primary" href={caseStudyUrl}>
              Case study
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </a>
          )
        }
        {
          data.demoUrl && (
            <a
              class="work-item__link"
              href={data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Live site
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 17L17 7M17 7H7m10 0v10"
                />
              </svg>
            </a>
          )
        }
        {
          data.githubUrl && (
            <a
              class="work-item__link"
              href={data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Source
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </article>
</div>

<style>
  /* ---------------------------------------------------------------------
     Each project is a "spread": a framed screenshot with the copy card
     overlapping its inner edge, sides alternating down the page. The overlap
     and the alternation carry the rhythm, so no divider rules are needed.

     Layout comes from a container query on the card's own wrapper, not the
     viewport, so a spread stays correct inside any column. Without
     @container support the stacked layout renders - a readable default.
     --------------------------------------------------------------------- */
  .work-shell {
    container-type: inline-size;
    container-name: work;
  }

  .work-item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 1.25rem 0 2.5rem;
  }

  .work-item__media {
    min-width: 0;
  }

  /* Stacked: the copy card still tucks under the frame's bottom edge */
  .work-item__body {
    position: relative;
    z-index: 2;
    margin: -2rem 0 0 0;
    width: calc(100% - 1.5rem);
    padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background-color: var(--bg-elevated);
    transition:
      border-color 0.3s var(--ease-soft),
      transform 0.45s var(--ease-spring);
  }
  .is-left .work-item__body {
    margin-left: auto;
  }

  @container work (min-width: 44rem) {
    .work-item {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      padding: 2.5rem 0 3.5rem;
    }
    .work-item__media {
      grid-row: 1;
    }
    .work-item__body {
      grid-row: 1;
      width: auto;
      margin: 0;
      padding: 1.75rem 1.85rem 1.9rem;
    }
    /* Columns deliberately share one track, so the copy card sits over the
       screenshot's inner edge instead of beside it. */
    .is-left .work-item__media {
      grid-column: 1 / span 7;
    }
    .is-left .work-item__body {
      grid-column: 7 / span 6;
    }
    .is-right .work-item__media {
      grid-column: 6 / span 7;
    }
    .is-right .work-item__body {
      grid-column: 1 / span 6;
    }
  }

  /* ---------------------------------------------------------------------
     Browser chrome around the screenshot - signals "this is a real, live
     thing" and gives the flat screenshots an edge to sit against.
     --------------------------------------------------------------------- */
  .work-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background-color: var(--bg-elevated);
    text-decoration: none;
    transition:
      border-color 0.3s var(--ease-soft),
      box-shadow 0.45s var(--ease-spring),
      transform 0.45s var(--ease-spring);
  }

  .work-frame__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--border) 22%, var(--bg-elevated));
  }
  /* On right-hand spreads the copy card covers the frame's left edge, so the
     chrome mirrors to keep the dots and address visible. */
  @container work (min-width: 44rem) {
    .is-right .work-frame__bar {
      flex-direction: row-reverse;
    }
  }
  .work-frame__dots {
    display: flex;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .work-frame__dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--border);
    transition: background-color 0.3s var(--ease-soft);
  }
  .work-frame__url {
    overflow: hidden;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-muted);
  }

  .work-frame__shot {
    display: block;
    overflow: hidden;
  }
  .work-frame__shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-soft);
  }
  .work-frame__shot--empty {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
  }
  .work-frame__mono {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8cqw, 4.5rem);
    font-weight: 700;
    color: var(--text-muted);
    opacity: 0.3;
  }

  /* Cursor sheen, clipped to the frame. Its opacity is driven purely by
     :hover in CSS - the script below only moves it - so it can never linger
     on one project while the pointer is over another. */
  .work-frame__sheen {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      16rem 16rem at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 26%, transparent) 0%,
      color-mix(in srgb, var(--accent) 9%, transparent) 40%,
      transparent 72%
    );
    transition: opacity 0.35s var(--ease-soft);
  }

  /* One hover target per spread: pointing anywhere in the article lights it */
  .work-item:hover .work-frame,
  .work-item:focus-within .work-frame {
    border-color: var(--accent);
    box-shadow: 6px 6px 0 0 var(--accent);
    transform: translate(-3px, -3px);
  }
  .work-item:hover .work-frame__dots i,
  .work-item:focus-within .work-frame__dots i {
    background-color: var(--accent);
  }
  .work-item:hover .work-frame__shot img,
  .work-item:focus-within .work-frame__shot img {
    transform: scale(1.015);
  }
  .work-item:hover .work-item__body,
  .work-item:focus-within .work-item__body {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .work-item:hover .work-item__tick,
  .work-item:focus-within .work-item__tick {
    width: 3.5rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-frame:hover .work-frame__sheen {
      opacity: 1;
    }
  }

  /* ---------------------------------------------------------------------
     Copy card
     --------------------------------------------------------------------- */
  .work-item__tick {
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-bottom: 0.9rem;
    border-radius: 2px;
    background-color: var(--accent);
    transition: width 0.45s var(--ease-spring);
  }

  .work-item__kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .work-item__num {
    font-variant-numeric: tabular-nums;
    color: var(--accent-text);
  }
  .work-item__status::before {
    content: "";
    display: inline-block;
    width: 0.9rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background-color: var(--border);
  }

  .work-item__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text);
  }
  @container work (min-width: 44rem) {
    .work-item__title {
      font-size: 2rem;
    }
  }
  @container work (min-width: 58rem) {
    .work-item__title {
      font-size: 2.3rem;
    }
  }
  .work-item__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s var(--ease-soft);
  }
  .work-item__title a:hover {
    color: var(--accent-text);
  }

  .work-item__desc {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
  @container work (min-width: 44rem) {
    .work-item__desc {
      font-size: 0.95rem;
    }
  }

  .work-item__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.15rem;
  }
  .work-item__tech li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .work-item__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.35rem;
  }
  .work-item__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition:
      color 0.25s var(--ease-soft),
      transform 0.4s var(--ease-spring);
  }
  .work-item__link svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.35s var(--ease-spring);
  }
  .work-item__link:hover {
    color: var(--accent-text);
  }
  /* The inward link is the one that should win the eye */
  .work-item__link--primary {
    color: var(--accent-text);
  }
  .work-item__link--primary::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: var(--accent);
  }
  .work-item__link:hover svg {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-frame__sheen {
      display: none;
    }
  }
</style>

<script>
  /**
   * Moves the cursor sheen inside whichever project frame the pointer is over.
   *
   * Visibility is CSS `:hover` only - this script writes --mx/--my and nothing
   * else - so a sheen can never stay lit on a project the pointer has already
   * left, which is what made the old spotlight flicker between cards.
   *
   * Bound once on `document` with event delegation, so it costs one listener
   * regardless of project count and survives client-side navigation.
   */
  (function () {
    if ((window as any).__workSheenBound) return;
    (window as any).__workSheenBound = true;

    let pending: PointerEvent | null = null;
    let frame = 0;

    function apply() {
      frame = 0;
      const event = pending;
      pending = null;
      if (!event) return;

      const target = event.target as Element | null;
      const el = target?.closest?.(".work-frame") as HTMLElement | null;
      if (!el) return;

      const rect = el.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      const px = ((event.clientX - rect.left) / rect.width) * 100;
      const py = ((event.clientY - rect.top) / rect.height) * 100;
      el.style.setProperty("--mx", px.toFixed(1) + "%");
      el.style.setProperty("--my", py.toFixed(1) + "%");
    }

    document.addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType !== "mouse") return;
        pending = event;
        if (!frame) frame = requestAnimationFrame(apply);
      },
      { passive: true }
    );
  })();
</script>
