---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { hasCaseStudy } from "../utils/projects";

export interface Props {
  project: CollectionEntry<"projects">;
  index?: number;
  total?: number;
}
const { project, index = 0, total = 1 } = Astro.props;
const { data } = project;

/** Projects with a real write-up get a case-study page; the rest link straight out. */
const caseStudyUrl = hasCaseStudy(project.body) ? `/projects/${project.slug}/` : null;
/** The title goes inward when there is something to read, outward otherwise. */
const linkUrl = caseStudyUrl || data.demoUrl || data.githubUrl;
const num = String(index + 1).padStart(2, "0");
const of = String(total).padStart(2, "0");

/** Address shown in the frame's chrome: the live host, or the repo path. */
function addressBar() {
  const raw = data.demoUrl || data.githubUrl;
  if (!raw) return "";
  try {
    const url = new URL(raw);
    // Keep the path for sites under a shared host (github.io, github.com).
    return url.hostname.replace(/^www\./, "") + url.pathname.replace(/\/$/, "");
  } catch {
    return raw;
  }
}

const meta = [data.year, data.role].filter(Boolean).join(" · ");
const status = data.demoUrl ? "Live" : data.githubUrl ? "Open source" : "Shipped";
---

<article class="work" style={`--i: ${index}`}>
  <div class="work__card card spotlight">
    <div class="work__copy">
      <p class="work__kicker font-mono">
        <span class="work__num">{num}<span class="work__of">/{of}</span></span>
        {meta && <span>{meta}</span>}
      </p>

      <h3 class="work__title">
        {
          linkUrl ? (
            <a
              href={linkUrl}
              class="work__stretched"
              target={caseStudyUrl ? undefined : "_blank"}
              rel={caseStudyUrl ? undefined : "noopener noreferrer"}
            >
              {data.title}
            </a>
          ) : (
            data.title
          )
        }
      </h3>

      <p class="work__desc text-pretty">{data.description}</p>

      {
        data.techStack && data.techStack.length > 0 && (
          <ul class="tag-list work__tags" aria-label="Tech stack">
            {data.techStack.map((tech) => (
              <li class="tag">{tech}</li>
            ))}
          </ul>
        )
      }

      <div class="work__links">
        {
          caseStudyUrl && (
            <a class="btn btn--primary" href={caseStudyUrl}>
              Read case study
              <svg class="icon-arrow-r" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )
        }
        {
          data.demoUrl && (
            <a class="btn" href={data.demoUrl} target="_blank" rel="noopener noreferrer">
              Live
              <svg class="icon-arrow-ur" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )
        }
        {
          data.githubUrl && (
            <a class="btn" href={data.githubUrl} target="_blank" rel="noopener noreferrer">
              Source
              <svg class="icon-arrow-ur" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <div class="work__media" aria-hidden="true">
      <div class="work__frame">
        <div class="work__bar">
          <span class="work__dots"><i></i><i></i><i></i></span>
          <span class="work__url font-mono">{addressBar() || data.title.toLowerCase()}</span>
          <span class="work__status font-mono"><span class="live-dot"></span>{status}</span>
        </div>
        {
          data.image ? (
            <div class="work__shot">
              {/* astro:assets emits resized WebP variants and stamps intrinsic
                  width/height, so the frame reserves its space before the image
                  lands instead of shifting the page. */}
              <Image
                src={data.image}
                alt=""
                widths={[480, 768, 1120]}
                sizes="(min-width: 1024px) 600px, 92vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class="work__poster grid-bg">
              <span class="work__poster-title serif-accent">{data.title}</span>
              {data.techStack && (
                <span class="work__poster-stack font-mono">{data.techStack.slice(0, 3).join(" / ")}</span>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  /* ---------------------------------------------------------------------
     Stacking cards: on wide screens each card sticks a little lower than
     the last, so scrolling deals them onto a pile. Small screens get a
     plain column - a tall card pinned on a phone just traps the reader.
     --------------------------------------------------------------------- */
  .work {
    container-type: inline-size;
    container-name: work;
  }
  .work + :global(.work) {
    margin-top: 1.25rem;
  }
  @media (min-width: 960px) and (min-height: 700px) {
    .work {
      position: sticky;
      top: calc(var(--nav-h) + 1.25rem + var(--i) * 1.1rem);
    }
    .work + :global(.work) {
      margin-top: 2.5rem;
    }
  }

  .work__card {
    display: grid;
    gap: 1.75rem;
    padding: 1.25rem;
    border-radius: 1.75rem;
    transition: border-color 0.3s var(--ease-soft);
  }
  .work__card:hover {
    border-color: var(--border-strong);
  }
  @container work (min-width: 52rem) {
    .work__card {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      align-items: stretch;
      gap: 2.5rem;
      padding: 1.5rem 1.5rem 1.5rem 2.5rem;
      min-height: 30rem;
    }
  }

  .work__copy {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.25rem 0.25rem;
  }
  @container work (min-width: 52rem) {
    .work__copy {
      padding: 1rem 0;
    }
  }

  .work__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .work__num {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .work__of {
    color: var(--text-faint);
  }

  .work__title {
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 6cqi, 3.6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--text);
  }
  .work__title a {
    color: inherit;
    text-decoration: none;
  }
  /* The title link stretches over the whole card; other links sit above it. */
  .work__stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .work__card:has(.work__stretched:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .work__stretched:focus-visible {
    outline: none;
  }

  .work__desc {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .work__tags {
    margin-top: 1.4rem;
  }
  .work__links {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  @container work (min-width: 52rem) {
    .work__links {
      margin-top: auto;
      padding-top: 2rem;
    }
  }

  /* --- Media --------------------------------------------------------- */
  .work__media {
    position: relative;
    order: -1;
    min-width: 0;
    border-radius: 1.15rem;
    background: var(--bg-subtle);
    overflow: hidden;
  }
  @container work (min-width: 52rem) {
    .work__media {
      order: 0;
      display: flex;
      align-items: center;
      padding: 2rem 0 2rem 2rem;
    }
  }
  /* Accent glow behind the frame */
  .work__media::before {
    content: "";
    position: absolute;
    right: -20%;
    bottom: -30%;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    pointer-events: none;
  }

  .work__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 0.9rem;
    background: var(--bg-elevated);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.45);
    transition: transform 0.7s var(--ease-soft);
  }
  @container work (min-width: 52rem) {
    .work__frame {
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
      border-right: 0;
    }
  }
  .work__card:hover .work__frame {
    transform: translateX(-0.5rem) scale(1.01);
  }

  .work__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  .work__dots {
    display: flex;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .work__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .work__url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.68rem;
    color: var(--text-muted);
  }
  .work__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .work__status .live-dot {
    width: 0.4rem;
    height: 0.4rem;
  }

  .work__shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .work__poster {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    aspect-ratio: 16 / 10;
    padding: 1.75rem;
    overflow: hidden;
    background-color: var(--bg);
    background-position: -1px -1px;
  }
  .work__poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 70% at 85% 15%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 70%);
    pointer-events: none;
  }
  .work__poster-title {
    position: relative;
    font-size: clamp(3rem, 11cqi, 6rem);
    line-height: 0.9;
    color: var(--text);
  }
  .work__poster-stack {
    position: relative;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
