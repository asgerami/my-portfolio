---
import type { CollectionEntry } from "astro:content";

export interface Props {
  project: CollectionEntry<"projects">;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { data } = project;
const imageUrl = data.image || null;
const linkUrl = data.demoUrl || data.githubUrl;
const isEven = index % 2 === 0;
---

<div class="project-shell">
<!-- Narrow container: vertical card -->
<article
  class="project-card-mobile card card-hover overflow-hidden group"
>
  <div class="aspect-video w-full overflow-hidden">
    {
      imageUrl ? (
        <a href={linkUrl} target={linkUrl ? "_blank" : undefined} rel={linkUrl ? "noopener noreferrer" : undefined} class="block h-full w-full">
          <img
            src={imageUrl}
            alt={`${data.title} screenshot`}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <div class="project-placeholder relative flex h-full w-full items-center justify-center">
          <span class="project-placeholder__corner project-placeholder__corner--tl" aria-hidden="true" />
          <span class="project-placeholder__corner project-placeholder__corner--br" aria-hidden="true" />
          <span
            class="font-display text-4xl font-bold select-none"
            style="color: var(--text-muted); opacity: 0.35;"
          >
            {data.title.charAt(0)}
          </span>
        </div>
      )
    }
  </div>
  <div class="p-4 md:p-5">
    <div class="flex items-start justify-between gap-2">
      {linkUrl ? (
        <a
          href={linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display font-semibold text-lg transition-colors hover:opacity-90"
          style="color: var(--text);"
        >
          {data.title}
        </a>
      ) : (
        <h3 class="font-display font-semibold text-lg" style="color: var(--text);">
          {data.title}
        </h3>
      )}
      <div class="flex shrink-0 gap-1">
        {
          data.githubUrl && (
            <a
              href={data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg p-1.5 transition-colors hover:bg-[var(--accent-muted)]"
              style="color: var(--text-muted);"
              aria-label="GitHub"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
          )
        }
        {
          data.demoUrl && (
            <a
              href={data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg p-1.5 transition-colors hover:bg-[var(--accent-muted)]"
              style="color: var(--text-muted);"
              aria-label="View demo"
            >
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
          )
        }
      </div>
    </div>
    <p
      class="mt-2 text-sm leading-relaxed line-clamp-2"
      style="color: var(--text-muted);"
    >
      {data.description}
    </p>
    {
      data.techStack && data.techStack.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tech">
          {data.techStack.slice(0, 5).map((tech) => (
            <li>
              <span
                class="rounded-md px-2 py-0.5 text-xs font-medium"
                style="background: var(--accent-muted); color: var(--accent-text);"
              >
                {tech}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<!-- Wide container: rule-line two-column layout with hard-shadow hover -->
<div class="project-card-desktop group" data-tilt>
  <span class="project-spotlight" aria-hidden="true"></span>
  <!-- Image side -->
  <div class={`project-col ${isEven ? "order-1" : "order-2"}`}>
    {
      imageUrl ? (
        <a
          href={linkUrl}
          target={linkUrl ? "_blank" : undefined}
          rel={linkUrl ? "noopener noreferrer" : undefined}
          class="project-frame relative block overflow-hidden rounded-xl border"
          style="border-color: var(--border);"
        >
          <img
            src={imageUrl}
            alt={`${data.title} screenshot`}
            class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <div
          class="project-frame project-placeholder relative flex aspect-video w-full items-center justify-center rounded-xl border"
          style="border-color: var(--border);"
        >
          <span class="project-placeholder__corner project-placeholder__corner--tl" aria-hidden="true" />
          <span class="project-placeholder__corner project-placeholder__corner--br" aria-hidden="true" />
          <span
            class="font-display font-bold select-none"
            style="color: var(--text-muted); opacity: 0.3; font-size: clamp(2.5rem, 5vw, 4.5rem);"
          >
            {data.title.charAt(0)}
          </span>
        </div>
      )
    }
  </div>

  <!-- Content side -->
  <div class={`project-col ${isEven ? "order-2" : "order-1"} flex flex-col`}>
    <!-- Title -->
    <h3
      class="font-display font-bold text-3xl lg:text-4xl xl:text-5xl mb-6 transition-colors group-hover:opacity-90"
      style="color: var(--text);"
    >
      {data.title}
    </h3>

    <!-- Description box with rule-line accent -->
    <div
      class="rounded-xl p-5 lg:p-6 mb-6 border-l-2"
      style="background: var(--accent-muted); border-color: var(--accent);"
    >
      <p
        class="text-sm lg:text-base leading-relaxed"
        style="color: var(--text-muted);"
      >
        {data.description}
      </p>
    </div>

    <!-- Tech stack as flat inline list -->
    {
      data.techStack && data.techStack.length > 0 && (
        <div class="flex flex-wrap gap-x-5 gap-y-2 mb-5">
          {data.techStack.map((tech) => (
            <span
              class="text-sm font-semibold tracking-wide"
              style="color: var(--accent-text);"
            >
              {tech}
            </span>
          ))}
        </div>
      )
    }

    <!-- Link icon -->
    <div class="flex items-center gap-3">
      {
        data.githubUrl && (
          <a
            href={data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-spring rounded-lg p-1.5 hover:bg-[var(--accent-muted)]"
            style="color: var(--text-muted);"
            aria-label="GitHub"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
        )
      }
      {
        data.demoUrl && (
          <a
            href={data.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-spring rounded-lg p-1.5 hover:bg-[var(--accent-muted)]"
            style="color: var(--text-muted);"
            aria-label="View demo"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</div>
</div>

<style>
  /* ---------------------------------------------------------------------
     Container queries: the card picks its layout from the width of its own
     wrapper, not the viewport, so it stays correct inside any column.
     Without @container support the narrow (stacked) card is what renders -
     a safe, fully-readable default.
     --------------------------------------------------------------------- */
  .project-shell {
    container-type: inline-size;
    container-name: project;
  }

  .project-card-mobile {
    display: block;
  }
  .project-card-desktop {
    display: none;
  }

  @container project (min-width: 44rem) {
    .project-card-mobile {
      display: none;
    }
    .project-card-desktop {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: center;
      padding: 2rem 0;
    }
  }
  @container project (min-width: 58rem) {
    .project-card-desktop {
      gap: 2.5rem;
    }
  }

  .project-col {
    position: relative;
    z-index: 1;
  }

  /* ---------------------------------------------------------------------
     Cursor-reactive spotlight + tilt.
     --mx/--my/--tilt-rx/--tilt-ry are written by the shared script below,
     desktop pointers only, and never when reduced motion is requested.
     --------------------------------------------------------------------- */
  .project-spotlight {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-spotlight {
      display: block;
      position: absolute;
      inset: -1.5rem;
      z-index: -1;
      pointer-events: none;
      border-radius: 1.5rem;
      opacity: 0;
      transition: opacity 0.4s var(--ease-soft);
      background: radial-gradient(
        28rem 28rem at var(--mx, 50%) var(--my, 50%),
        color-mix(in srgb, var(--accent) 18%, transparent) 0%,
        color-mix(in srgb, var(--accent) 7%, transparent) 35%,
        transparent 70%
      );
    }
    .project-card-desktop[data-tilt-on] .project-spotlight {
      opacity: 1;
    }
  }

  .project-frame {
    transition:
      border-color 0.3s var(--ease-soft),
      box-shadow 0.45s var(--ease-spring),
      transform 0.45s var(--ease-spring);
  }
  .group:hover .project-frame,
  .group:focus-within .project-frame {
    border-color: var(--accent);
    box-shadow: 6px 6px 0 0 var(--accent);
    transform: translate(-3px, -3px);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-card-desktop[data-tilt-on] .project-frame {
      transform: translate(-3px, -3px) perspective(1200px)
        rotateX(var(--tilt-rx, 0deg)) rotateY(var(--tilt-ry, 0deg));
      transition:
        border-color 0.3s var(--ease-soft),
        box-shadow 0.45s var(--ease-spring),
        transform 120ms ease-out;
    }
  }

  .project-placeholder {
    background: var(--bg-elevated);
  }
  .project-placeholder__corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border-style: solid;
    border-width: 0;
    border-color: var(--border);
  }
  .project-placeholder__corner--tl {
    top: 10px;
    left: 10px;
    border-top-width: 2px;
    border-left-width: 2px;
  }
  .project-placeholder__corner--br {
    bottom: 10px;
    right: 10px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }
</style>

<script>
  /**
   * Cursor-reactive spotlight + tilt for project cards.
   *
   * Bundled once by Astro no matter how many cards are on the page, and bound
   * with event delegation on `document`, so it survives client-side navigation
   * without needing an `astro:page-load` re-init.
   *
   * Gated on `(hover: hover) and (pointer: fine)` and disabled outright under
   * `prefers-reduced-motion: reduce` - both checked live, so toggling either
   * mid-session takes effect immediately.
   */
  (function () {
    if ((window as any).__projectTiltBound) return;
    (window as any).__projectTiltBound = true;

    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const enabled = () => finePointer.matches && !reduceMotion.matches;

    let active: HTMLElement | null = null;
    let pending: PointerEvent | null = null;
    let frame = 0;

    function clear(el: HTMLElement) {
      el.removeAttribute("data-tilt-on");
      el.style.removeProperty("--mx");
      el.style.removeProperty("--my");
      el.style.removeProperty("--tilt-rx");
      el.style.removeProperty("--tilt-ry");
    }

    function release() {
      if (active) clear(active);
      active = null;
    }

    function apply() {
      frame = 0;
      const event = pending;
      pending = null;
      if (!event || !active) return;

      const rect = active.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      const px = (event.clientX - rect.left) / rect.width;
      const py = (event.clientY - rect.top) / rect.height;

      active.style.setProperty("--mx", (px * 100).toFixed(2) + "%");
      active.style.setProperty("--my", (py * 100).toFixed(2) + "%");
      // Small angles only - this is a nudge, not a carousel.
      active.style.setProperty("--tilt-rx", ((0.5 - py) * 4).toFixed(2) + "deg");
      active.style.setProperty("--tilt-ry", ((px - 0.5) * 5).toFixed(2) + "deg");
    }

    document.addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType !== "mouse" || !enabled()) {
          release();
          return;
        }

        const target = event.target as Element | null;
        const card =
          target && target.closest ? (target.closest("[data-tilt]") as HTMLElement | null) : null;

        if (card !== active) {
          release();
          active = card;
          if (card) card.setAttribute("data-tilt-on", "");
        }
        if (!active) return;

        pending = event;
        if (!frame) frame = requestAnimationFrame(apply);
      },
      { passive: true }
    );

    document.addEventListener("pointerleave", release);
    window.addEventListener("blur", release);
    document.addEventListener("astro:before-swap", release);
    reduceMotion.addEventListener("change", release);
  })();
</script>
